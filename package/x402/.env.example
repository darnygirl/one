# X402 Configuration
# Copy this file to .env and fill in your values

# Enable X402 payments
PUBLIC_X402_ENABLED=true

# Base Network USDC Contract Address (Do not change)
PUBLIC_USDC_CONTRACT_ADDRESS=0x833589fCD6eDb6E08f4c7C32D4f71b54bdA02913

# Your merchant wallet address (where you receive payments)
PUBLIC_MERCHANT_WALLET=0xYourWalletAddressHere

# WalletConnect Project ID (Get from cloud.walletconnect.com)
PUBLIC_WALLETCONNECT_PROJECT_ID=your_walletconnect_project_id_here

# Optional: Custom RPC URL for Base network
# PUBLIC_BASE_RPC_URL=https://mainnet.base.org
