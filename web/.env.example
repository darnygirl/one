# ================================
# Environment Variables Template
# ================================
# Copy this file to .env.local and fill in your actual values
# NEVER commit .env.local to version control!

# ================================
# Stripe Payment Processing
# ================================
# Get your keys from https://dashboard.stripe.com/apikeys
# Toggle "Test mode" ON for development keys

# Public key (safe to expose in browser)
PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Secret key (NEVER expose in browser, server-side only)
STRIPE_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ================================
# YouTube Data API v3
# ================================
# Get your API key from https://console.cloud.google.com/apis/credentials
# Enable YouTube Data API v3 in Google Cloud Console
# Used for fetching creator videos from YouTube channels

# Public YouTube API key (client-side, limited quota)
PUBLIC_YOUTUBE_API_KEY=AIzaSyXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX

# API Limits:
# - Free tier: 10,000 quota units per day
# - Each search/list request costs 100 units
# - Can fetch ~100 videos per day on free tier
# - For higher limits, consider backend caching or paid quota

