---
/**
 * Public Creator Video Hub
 *
 * Displays all videos from a creator's YouTube channel on their public profile.
 * Accessible at /creators/[slug]/videos
 *
 * Features:
 * - Creator branding (avatar, name, subscriber count)
 * - Video gallery with sorting
 * - Responsive grid layout
 * - SEO optimized
 * - No authentication required (public page)
 *
 * Data Sources (Progressive):
 * 1. Hardcoded creator data (for demo)
 * 2. YouTube API (fetch videos dynamically)
 * 3. Convex backend (when implemented)
 */

import Layout from '@/layouts/Layout.astro';
import { VideoGallery } from '@/components/media/VideoGallery';
import { Card, CardContent, CardHeader, CardTitle } from '@/components/ui/card';
import { Badge } from '@/components/ui/badge';
import { Button } from '@/components/ui/button';

export const prerender = false; // Enable dynamic routing

// Get the slug from the URL
const { slug } = Astro.params;

// Hardcoded creator data (for demo - replace with database later)
const creators = {
  'linus-tech-tips': {
    name: 'Linus Tech Tips',
    username: '@LinusTechTips',
    avatar: 'https://yt3.googleusercontent.com/ytc/AIdro_khL36bVvhQUJy-YEZPSlNWE6Hpj-x5YBfHo8eZyJO3PQ=s176-c-k-c0x00ffffff-no-rj',
    channelId: 'UCXuqSBlHAE6Xw-yeJA0Tunw',
    description: 'We make entertaining videos about technology, including tech reviews, showcases and other content.',
    subscribers: '15.9M',
    totalVideos: '7.2K',
    verified: true,
  },
  'fireship': {
    name: 'Fireship',
    username: '@Fireship',
    avatar: 'https://yt3.googleusercontent.com/ytc/AIdro_kGRQ-l8bOFCCiDp1Tj6UF2UZDMm7L3wDzTUK-7=s176-c-k-c0x00ffffff-no-rj',
    channelId: 'UCsBjURrPoezykLs9EqgamOA',
    description: 'High-intensity ⚡ code tutorials and tech news to help you ship your app faster.',
    subscribers: '3.2M',
    totalVideos: '520',
    verified: true,
  },
  'demo-creator': {
    name: 'Demo Creator',
    username: '@DemoCreator',
    avatar: '/images/default-avatar.jpg',
    channelId: '', // No real channel - will show placeholder
    description: 'This is a demo creator account showing how the ONE Platform creator system works.',
    subscribers: '0',
    totalVideos: '0',
    verified: false,
  },
};

// Get creator data
const creator = creators[slug as keyof typeof creators];

// If creator not found, show 404
if (!creator) {
  return Astro.redirect('/404');
}

// Page metadata
const pageTitle = `${creator.name} - Videos`;
const pageDescription = creator.description;
---

<Layout
  title={pageTitle}
  description={pageDescription}
  sidebarInitialCollapsed={false}
>
  <div class="container mx-auto py-6 sm:py-8 lg:py-12 px-4 sm:px-6 lg:px-8 max-w-7xl">
    <!-- Creator Header -->
    <div class="mb-8 sm:mb-12">
      <Card class="border-primary/20">
        <CardContent class="pt-6">
          <div class="flex flex-col sm:flex-row items-center sm:items-start gap-6">
            <!-- Avatar -->
            <div class="relative">
              <img
                src={creator.avatar}
                alt={creator.name}
                class="w-24 h-24 sm:w-32 sm:h-32 rounded-full border-4 border-primary/20"
              />
              {creator.verified && (
                <div class="absolute bottom-0 right-0 w-8 h-8 bg-primary rounded-full flex items-center justify-center border-2 border-background">
                  <svg class="w-5 h-5 text-primary-foreground" fill="currentColor" viewBox="0 0 20 20">
                    <path fill-rule="evenodd" d="M6.267 3.455a3.066 3.066 0 001.745-.723 3.066 3.066 0 013.976 0 3.066 3.066 0 001.745.723 3.066 3.066 0 012.812 2.812c.051.643.304 1.254.723 1.745a3.066 3.066 0 010 3.976 3.066 3.066 0 00-.723 1.745 3.066 3.066 0 01-2.812 2.812 3.066 3.066 0 00-1.745.723 3.066 3.066 0 01-3.976 0 3.066 3.066 0 00-1.745-.723 3.066 3.066 0 01-2.812-2.812 3.066 3.066 0 00-.723-1.745 3.066 3.066 0 010-3.976 3.066 3.066 0 00.723-1.745 3.066 3.066 0 012.812-2.812zm7.44 5.252a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd" />
                  </svg>
                </div>
              )}
            </div>

            <!-- Creator Info -->
            <div class="flex-1 text-center sm:text-left">
              <div class="flex flex-col sm:flex-row items-center sm:items-start gap-3 mb-3">
                <h1 class="text-2xl sm:text-3xl font-bold">{creator.name}</h1>
                {creator.verified && (
                  <Badge variant="secondary" class="flex items-center gap-1">
                    <svg class="w-3 h-3" fill="currentColor" viewBox="0 0 20 20">
                      <path fill-rule="evenodd" d="M6.267 3.455a3.066 3.066 0 001.745-.723 3.066 3.066 0 013.976 0 3.066 3.066 0 001.745.723 3.066 3.066 0 012.812 2.812c.051.643.304 1.254.723 1.745a3.066 3.066 0 010 3.976 3.066 3.066 0 00-.723 1.745 3.066 3.066 0 01-2.812 2.812 3.066 3.066 0 00-1.745.723 3.066 3.066 0 01-3.976 0 3.066 3.066 0 00-1.745-.723 3.066 3.066 0 01-2.812-2.812 3.066 3.066 0 00-.723-1.745 3.066 3.066 0 010-3.976 3.066 3.066 0 00.723-1.745 3.066 3.066 0 012.812-2.812zm7.44 5.252a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd" />
                    </svg>
                    Verified
                  </Badge>
                )}
              </div>
              <p class="text-muted-foreground mb-4 max-w-2xl">
                {creator.description}
              </p>
              <div class="flex flex-wrap justify-center sm:justify-start gap-4 text-sm text-muted-foreground">
                <span class="flex items-center gap-1.5">
                  <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z" />
                  </svg>
                  <span class="font-medium">{creator.subscribers}</span> subscribers
                </span>
                <span class="flex items-center gap-1.5">
                  <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 10l4.553-2.276A1 1 0 0121 8.618v6.764a1 1 0 01-1.447.894L15 14M5 18h8a2 2 0 002-2V8a2 2 0 00-2-2H5a2 2 0 00-2 2v8a2 2 0 002 2z" />
                  </svg>
                  <span class="font-medium">{creator.totalVideos}</span> videos
                </span>
              </div>
            </div>

            <!-- Subscribe button -->
            <div class="flex flex-col gap-3">
              <Button class="whitespace-nowrap">
                Subscribe
              </Button>
              {creator.channelId && (
                <Button variant="outline" asChild>
                  <a href={`https://www.youtube.com/channel/${creator.channelId}`} target="_blank" rel="noopener">
                    View on YouTube
                  </a>
                </Button>
              )}
            </div>
          </div>
        </CardContent>
      </Card>
    </div>

    <!-- Videos Section -->
    <div id="videos-section">
      <!-- Loading state -->
      <div id="videos-loading" class="py-12">
        <div class="flex flex-col items-center gap-4">
          <div class="h-12 w-12 animate-spin rounded-full border-4 border-primary border-t-transparent"></div>
          <p class="text-muted-foreground">Loading videos...</p>
        </div>
      </div>

      <!-- Empty state -->
      <div id="videos-empty" class="hidden py-12">
        <Card>
          <CardContent class="pt-12 pb-12 text-center">
            <div class="w-20 h-20 rounded-full bg-muted flex items-center justify-center mx-auto mb-4">
              <svg class="w-10 h-10 text-muted-foreground" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 10l4.553-2.276A1 1 0 0121 8.618v6.764a1 1 0 01-1.447.894L15 14M5 18h8a2 2 0 002-2V8a2 2 0 00-2-2H5a2 2 0 00-2 2v8a2 2 0 002 2z" />
              </svg>
            </div>
            <h3 class="text-xl font-semibold mb-2">No videos yet</h3>
            <p class="text-muted-foreground">
              This creator hasn't published any videos on ONE Platform yet.
            </p>
          </CardContent>
        </Card>
      </div>

      <!-- Videos grid -->
      <div id="videos-grid" class="hidden">
        <div class="mb-6 flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4">
          <h2 class="text-2xl font-bold">
            <span id="video-count">0</span> Videos
          </h2>
          <select id="video-sort" class="px-4 py-2 border rounded-lg focus:outline-none focus:ring-2 focus:ring-primary">
            <option value="date">Newest First</option>
            <option value="views">Most Views</option>
            <option value="title">Title (A-Z)</option>
          </select>
        </div>

        <div id="video-cards" class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
          <!-- Video cards will be inserted here by JavaScript -->
        </div>
      </div>

      <!-- Error state -->
      <div id="videos-error" class="hidden py-12">
        <Card class="border-destructive/20 bg-destructive/5">
          <CardContent class="pt-6">
            <div class="flex items-start gap-4">
              <div class="w-12 h-12 rounded-full bg-destructive/10 flex items-center justify-center flex-shrink-0">
                <svg class="w-6 h-6 text-destructive" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4m0 4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
                </svg>
              </div>
              <div class="flex-1">
                <h3 class="font-semibold text-destructive mb-2">Failed to load videos</h3>
                <p class="text-sm text-muted-foreground mb-4" id="videos-error-message"></p>
                <Button variant="outline" id="retry-load-btn">
                  Try Again
                </Button>
              </div>
            </div>
          </CardContent>
        </Card>
      </div>
    </div>
  </div>
</Layout>

<script define:vars={{ creatorChannelId: creator.channelId }}>
  import { YouTubeService, type YouTubeVideo } from '@/services/YouTubeService';

  // Initialize YouTube service
  const youtubeService = new YouTubeService();

  // State
  let videos = [];

  // DOM elements
  const videosLoading = document.getElementById('videos-loading');
  const videosEmpty = document.getElementById('videos-empty');
  const videosGrid = document.getElementById('videos-grid');
  const videosError = document.getElementById('videos-error');
  const videosErrorMessage = document.getElementById('videos-error-message');
  const videoCards = document.getElementById('video-cards');
  const videoCount = document.getElementById('video-count');
  const videoSort = document.getElementById('video-sort');
  const retryLoadBtn = document.getElementById('retry-load-btn');

  // Load videos on page load
  if (creatorChannelId && youtubeService.isConfigured()) {
    loadVideos();
  } else {
    showVideosState('empty');
  }

  // Event listeners
  videoSort?.addEventListener('change', () => {
    sortAndRenderVideos();
  });

  retryLoadBtn?.addEventListener('click', () => {
    loadVideos();
  });

  // Functions
  function showVideosState(state) {
    hideElement(videosLoading);
    hideElement(videosEmpty);
    hideElement(videosGrid);
    hideElement(videosError);

    if (state === 'loading') showElement(videosLoading);
    if (state === 'empty') showElement(videosEmpty);
    if (state === 'grid') showElement(videosGrid);
    if (state === 'error') showElement(videosError);
  }

  async function loadVideos() {
    showVideosState('loading');

    try {
      // Fetch videos from YouTube
      const fetchedVideos = await youtubeService.getChannelVideos(creatorChannelId, 50);
      videos = fetchedVideos;

      if (videos.length === 0) {
        showVideosState('empty');
      } else {
        sortAndRenderVideos();
        showVideosState('grid');
      }
    } catch (error) {
      if (videosErrorMessage) {
        videosErrorMessage.textContent = error.message || 'Failed to load videos';
      }
      showVideosState('error');
    }
  }

  function sortAndRenderVideos() {
    const sortBy = videoSort?.value || 'date';

    // Sort videos
    const sortedVideos = [...videos].sort((a, b) => {
      if (sortBy === 'date') {
        return b.publishedAt.getTime() - a.publishedAt.getTime();
      } else if (sortBy === 'views') {
        return b.views - a.views;
      } else if (sortBy === 'title') {
        return a.title.localeCompare(b.title);
      }
      return 0;
    });

    renderVideos(sortedVideos);
  }

  function renderVideos(videosToRender) {
    if (!videoCards) return;

    if (videoCount) videoCount.textContent = String(videosToRender.length);

    videoCards.innerHTML = videosToRender.map(video => `
      <div class="group block transition-transform md:hover:scale-[1.02] rounded-xl">
        <div class="overflow-hidden h-full transition-shadow md:hover:shadow-xl border rounded-xl bg-card">
          <!-- Thumbnail -->
          <div class="relative aspect-video bg-muted overflow-hidden">
            <img
              src="${video.thumbnail}"
              alt="${escapeHtml(video.title)}"
              class="w-full h-full object-cover transition-transform md:group-hover:scale-105"
              loading="lazy"
            />
            <!-- Play icon -->
            <div class="absolute inset-0 flex items-center justify-center bg-black/20 md:opacity-0 md:group-hover:opacity-100 transition-opacity">
              <div class="w-16 h-16 rounded-full bg-primary/90 flex items-center justify-center backdrop-blur-sm shadow-lg">
                <svg class="w-8 h-8 text-primary-foreground fill-primary-foreground ml-1" viewBox="0 0 24 24">
                  <path d="M8 5v14l11-7z"/>
                </svg>
              </div>
            </div>
            <!-- Duration -->
            <div class="absolute bottom-2 right-2">
              <span class="bg-black/90 text-white px-2 py-0.5 rounded text-xs font-mono">
                ${video.durationFormatted}
              </span>
            </div>
          </div>

          <!-- Content -->
          <div class="p-4 space-y-3">
            <h3 class="font-semibold text-lg leading-tight line-clamp-2">
              ${escapeHtml(video.title)}
            </h3>
            <p class="text-sm text-muted-foreground line-clamp-2">
              ${escapeHtml(video.description)}
            </p>
            <div class="flex items-center justify-between text-sm text-muted-foreground">
              <span>${formatNumber(video.views)} views</span>
              <span>${formatDate(video.publishedAt)}</span>
            </div>
            <div class="flex gap-2 pt-2">
              <a
                href="https://www.youtube.com/watch?v=${video.videoId}"
                target="_blank"
                rel="noopener"
                class="flex-1 px-3 py-2 text-sm border rounded-lg hover:bg-accent text-center"
              >
                Watch on YouTube
              </a>
            </div>
          </div>
        </div>
      </div>
    `).join('');
  }

  // Utility functions
  function showElement(el) {
    if (el) el.classList.remove('hidden');
  }

  function hideElement(el) {
    if (el) el.classList.add('hidden');
  }

  function formatNumber(num) {
    if (num >= 1000000) return `${(num / 1000000).toFixed(1)}M`;
    if (num >= 1000) return `${(num / 1000).toFixed(1)}K`;
    return String(num);
  }

  function formatDate(date) {
    const now = new Date();
    const diffMs = now.getTime() - date.getTime();
    const diffDays = Math.floor(diffMs / (1000 * 60 * 60 * 24));

    if (diffDays === 0) return 'Today';
    if (diffDays === 1) return 'Yesterday';
    if (diffDays < 7) return `${diffDays} days ago`;
    if (diffDays < 30) return `${Math.floor(diffDays / 7)} weeks ago`;
    if (diffDays < 365) return `${Math.floor(diffDays / 30)} months ago`;
    return `${Math.floor(diffDays / 365)} years ago`;
  }

  function escapeHtml(text) {
    const div = document.createElement('div');
    div.textContent = text;
    return div.innerHTML;
  }
</script>
