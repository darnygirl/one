const totalComponents = categories.reduce((sum, cat) => sum + cat.count, 0);
---

<Layout title="Ontology-UI Components - 100 Crypto Components">
  <div class="min-h-screen bg-gradient-to-br from-slate-50 to-slate-100 dark:from-slate-950 dark:to-slate-900">
    <!-- Header -->
    <div class="border-b border-slate-200 dark:border-slate-800 bg-white/50 dark:bg-slate-950/50 backdrop-blur-sm sticky top-0 z-10">
      <div class="container mx-auto px-4 py-6">
        <div class="flex items-center justify-between">
          <div>
            <h1 class="text-4xl font-bold bg-gradient-to-r from-blue-600 to-purple-600 bg-clip-text text-transparent">
              Ontology-UI Components
            </h1>
            <p class="text-slate-600 dark:text-slate-400 mt-2">
              The most comprehensive Web3 component library - 100 production-ready components
            </p>
          </div>
          <div class="flex items-center gap-4">
            <div class="text-right">
              <div class="text-3xl font-bold text-blue-600 dark:text-blue-400">{totalComponents}</div>
              <div class="text-sm text-slate-600 dark:text-slate-400">Components</div>
            </div>
            <div class="text-right">
              <div class="text-3xl font-bold text-purple-600 dark:text-purple-400">4</div>
              <div class="text-sm text-slate-600 dark:text-slate-400">Phases</div>
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- Stats Bar -->
    <div class="bg-gradient-to-r from-blue-600 to-purple-600 text-white">
      <div class="container mx-auto px-4 py-8">
        <div class="grid grid-cols-2 md:grid-cols-4 gap-6">
          <div class="text-center">
            <div class="text-3xl font-bold">25</div>
            <div class="text-sm opacity-90">Wallet & Portfolio</div>
          </div>
          <div class="text-center">
            <div class="text-3xl font-bold">25</div>
            <div class="text-sm opacity-90">Payments & Transactions</div>
          </div>
          <div class="text-center">
            <div class="text-3xl font-bold">25</div>
            <div class="text-sm opacity-90">DeFi Integration</div>
          </div>
          <div class="text-center">
            <div class="text-3xl font-bold">25</div>
            <div class="text-sm opacity-90">Chat & Web3</div>
          </div>
        </div>
      </div>
    </div>

    <!-- Component Categories -->
    <div class="container mx-auto px-4 py-12">
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-6">
        {categories.map((category) => (
          <div class="bg-white dark:bg-slate-900 rounded-xl shadow-lg border border-slate-200 dark:border-slate-800 overflow-hidden hover:shadow-xl transition-shadow">
            <!-- Category Header -->
            <div class="bg-gradient-to-r from-slate-50 to-slate-100 dark:from-slate-800 dark:to-slate-900 px-6 py-4 border-b border-slate-200 dark:border-slate-700">
              <div class="flex items-center justify-between">
                <div>
                  <h2 class="text-xl font-bold text-slate-900 dark:text-white">
                    {category.name}
                  </h2>
                  <p class="text-sm text-slate-600 dark:text-slate-400 mt-1">
                    {category.description}
                  </p>
                </div>
                <div class="flex flex-col items-end gap-1">
                  <div class="px-3 py-1 bg-blue-100 dark:bg-blue-900/30 text-blue-700 dark:text-blue-300 rounded-full text-xs font-semibold">
                    Phase {category.phase}
                  </div>
                  <div class="text-xs text-slate-500 dark:text-slate-500">
                    Cycles {category.cycles}
                  </div>
                </div>
              </div>
            </div>

            <!-- Component List -->
            <div class="p-6">
              <div class="grid gap-3">
                {category.components.map((component) => (
                  <a
                    href={`/ontology-ui/${category.id}/${component.id}`}
                    class="group flex items-center justify-between p-3 rounded-lg border border-slate-200 dark:border-slate-700 hover:border-blue-500 dark:hover:border-blue-500 hover:bg-blue-50 dark:hover:bg-blue-950/20 transition-all"
                  >
                    <div class="flex-1">
                      <div class="font-mono text-sm font-semibold text-slate-900 dark:text-white group-hover:text-blue-600 dark:group-hover:text-blue-400">
                        {component.name}
                      </div>
                      <div class="text-xs text-slate-600 dark:text-slate-400 mt-0.5">
                        {component.description}
                      </div>
                    </div>
                    <svg class="w-5 h-5 text-slate-400 group-hover:text-blue-600 dark:group-hover:text-blue-400 transition-colors" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
                    </svg>
                  </a>
                ))}
              </div>
            </div>

            <!-- Category Footer -->
            <div class="px-6 py-3 bg-slate-50 dark:bg-slate-800/50 border-t border-slate-200 dark:border-slate-700">
              <div class="flex items-center justify-between text-sm">
                <span class="text-slate-600 dark:text-slate-400">
                  {category.count} component{category.count !== 1 ? 's' : ''}
                </span>
                <a
                  href={`/ontology-ui/${category.id}`}
                  class="text-blue-600 dark:text-blue-400 hover:underline font-medium"
                >
                  View all →
                </a>
              </div>
            </div>
          </div>
        ))}
      </div>
    </div>

    <!-- Footer -->
    <div class="border-t border-slate-200 dark:border-slate-800 bg-white/50 dark:bg-slate-950/50 backdrop-blur-sm mt-12">
      <div class="container mx-auto px-4 py-8">
        <div class="text-center">
          <p class="text-slate-600 dark:text-slate-400">
            Built with <span class="text-red-500">♥</span> using React 19, TypeScript, Effect.ts, and Tailwind CSS v4
          </p>
          <p class="text-sm text-slate-500 dark:text-slate-500 mt-2">
            All 100 components are production-ready and fully typed
          </p>
        </div>
      </div>
    </div>
  </div>
</Layout>
