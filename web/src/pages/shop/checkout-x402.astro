---
/**
 * X402 Checkout Page - ONE Platform E-Commerce
 * Multi-step checkout flow with X402 crypto payments
 * Based on product-landing.astro design principles
 *
 * Features:
 * - Cart review step
 * - Shipping address (if physical products)
 * - Payment method selection (X402 primary, Stripe fallback)
 * - Order confirmation
 * - Guest checkout support
 * - Dark mode support
 * - Responsive design
 */

import ShopLayout from '@/layouts/ShopLayout.astro';
import { ProductHeader } from '@/components/shop/ProductHeader';
import { ThemeToggle } from '@/components/shop/ThemeToggle';

// Check if user is authenticated
const isAuthenticated = false; // TODO: Get from session

// X402 configuration
const x402Enabled = import.meta.env.PUBLIC_X402_ENABLED === 'true';
const stripeEnabled = Boolean(import.meta.env.STRIPE_SECRET_KEY);
---

<ShopLayout title="Checkout - ONE Platform" description="Complete your purchase securely">
  <div class="bg-white dark:bg-black text-black dark:text-white min-h-screen">

    <!-- Header -->
    <ProductHeader client:load productName="Checkout" />

    <!-- Progress Bar -->
    <section class="max-w-4xl mx-auto px-6 py-8 border-b border-black dark:border-white">
      <div class="flex items-center justify-between">
        <div class="flex items-center gap-4 flex-1">
          <div class="flex items-center gap-3">
            <div id="step-1" class="step-indicator w-10 h-10 border-2 border-black dark:border-white flex items-center justify-center active">
              <span class="text-sm font-bold">1</span>
            </div>
            <span class="text-xs font-bold tracking-[0.2em] uppercase hidden md:inline">Cart</span>
          </div>
          <div class="flex-1 h-px bg-black dark:bg-white opacity-20"></div>
        </div>

        <div class="flex items-center gap-4 flex-1">
          <div class="flex-1 h-px bg-black dark:bg-white opacity-20"></div>
          <div class="flex items-center gap-3">
            <div id="step-2" class="step-indicator w-10 h-10 border-2 border-black dark:border-white flex items-center justify-center opacity-30">
              <span class="text-sm font-bold">2</span>
            </div>
            <span class="text-xs font-bold tracking-[0.2em] uppercase hidden md:inline">Shipping</span>
          </div>
          <div class="flex-1 h-px bg-black dark:bg-white opacity-20"></div>
        </div>

        <div class="flex items-center gap-4 flex-1">
          <div class="flex-1 h-px bg-black dark:bg-white opacity-20"></div>
          <div class="flex items-center gap-3">
            <div id="step-3" class="step-indicator w-10 h-10 border-2 border-black dark:border-white flex items-center justify-center opacity-30">
              <span class="text-sm font-bold">3</span>
            </div>
            <span class="text-xs font-bold tracking-[0.2em] uppercase hidden md:inline">Payment</span>
          </div>
        </div>
      </div>
    </section>

    <!-- Main Content -->
    <section class="max-w-6xl mx-auto px-6 py-12">
      <div class="grid lg:grid-cols-3 gap-12">

        <!-- Left: Checkout Steps -->
        <div class="lg:col-span-2 space-y-8">

          <!-- Step 1: Cart Review -->
          <div id="step-cart" class="checkout-step">
            <div class="mb-6">
              <h2 class="text-3xl font-light tracking-tight mb-2">Review Your Order</h2>
              <p class="text-sm opacity-60">Verify your items before proceeding</p>
            </div>

            <div id="cart-items" class="space-y-4 mb-8">
              <!-- Cart items will be populated by JavaScript -->
              <div class="border-2 border-black dark:border-white p-6 text-center">
                <p class="opacity-60">Loading cart...</p>
              </div>
            </div>

            <div class="flex gap-4">
              <a
                href="/shop/marketplace"
                class="flex-1 px-6 py-4 border-2 border-black dark:border-white text-center hover:bg-black dark:hover:bg-white hover:text-white dark:hover:text-black transition-colors"
              >
                <span class="text-xs font-bold tracking-[0.2em] uppercase">Continue Shopping</span>
              </a>
              <button
                onclick="nextStep()"
                class="flex-1 px-6 py-4 bg-black dark:bg-white text-white dark:text-black border-2 border-black dark:border-white hover:opacity-80 transition-opacity"
              >
                <span class="text-xs font-bold tracking-[0.2em] uppercase">Continue to Shipping</span>
              </button>
            </div>
          </div>

          <!-- Step 2: Shipping Address -->
          <div id="step-shipping" class="checkout-step hidden">
            <div class="mb-6">
              <h2 class="text-3xl font-light tracking-tight mb-2">Shipping Information</h2>
              <p class="text-sm opacity-60">Where should we send your order?</p>
            </div>

            <form id="shipping-form" class="space-y-6">
              <!-- Contact Information -->
              <div class="border-2 border-black dark:border-white p-6 space-y-4">
                <h3 class="text-sm font-bold tracking-[0.2em] uppercase mb-4">Contact</h3>
                <div>
                  <label class="block text-xs font-bold tracking-[0.2em] uppercase mb-2">Email</label>
                  <input
                    type="email"
                    name="email"
                    required
                    class="w-full px-4 py-3 border-2 border-black dark:border-white bg-transparent focus:outline-none focus:ring-2 focus:ring-black dark:focus:ring-white"
                    placeholder="your@email.com"
                  />
                </div>
              </div>

              <!-- Shipping Address -->
              <div class="border-2 border-black dark:border-white p-6 space-y-4">
                <h3 class="text-sm font-bold tracking-[0.2em] uppercase mb-4">Shipping Address</h3>

                <div class="grid grid-cols-2 gap-4">
                  <div>
                    <label class="block text-xs font-bold tracking-[0.2em] uppercase mb-2">First Name</label>
                    <input
                      type="text"
                      name="firstName"
                      required
                      class="w-full px-4 py-3 border-2 border-black dark:border-white bg-transparent focus:outline-none focus:ring-2 focus:ring-black dark:focus:ring-white"
                    />
                  </div>
                  <div>
                    <label class="block text-xs font-bold tracking-[0.2em] uppercase mb-2">Last Name</label>
                    <input
                      type="text"
                      name="lastName"
                      required
                      class="w-full px-4 py-3 border-2 border-black dark:border-white bg-transparent focus:outline-none focus:ring-2 focus:ring-black dark:focus:ring-white"
                    />
                  </div>
                </div>

                <div>
                  <label class="block text-xs font-bold tracking-[0.2em] uppercase mb-2">Address</label>
                  <input
                    type="text"
                    name="address"
                    required
                    class="w-full px-4 py-3 border-2 border-black dark:border-white bg-transparent focus:outline-none focus:ring-2 focus:ring-black dark:focus:ring-white"
                  />
                </div>

                <div>
                  <label class="block text-xs font-bold tracking-[0.2em] uppercase mb-2">Apartment, Suite, etc. (optional)</label>
                  <input
                    type="text"
                    name="apartment"
                    class="w-full px-4 py-3 border-2 border-black dark:border-white bg-transparent focus:outline-none focus:ring-2 focus:ring-black dark:focus:ring-white"
                  />
                </div>

                <div class="grid grid-cols-3 gap-4">
                  <div>
                    <label class="block text-xs font-bold tracking-[0.2em] uppercase mb-2">City</label>
                    <input
                      type="text"
                      name="city"
                      required
                      class="w-full px-4 py-3 border-2 border-black dark:border-white bg-transparent focus:outline-none focus:ring-2 focus:ring-black dark:focus:ring-white"
                    />
                  </div>
                  <div>
                    <label class="block text-xs font-bold tracking-[0.2em] uppercase mb-2">State</label>
                    <input
                      type="text"
                      name="state"
                      required
                      class="w-full px-4 py-3 border-2 border-black dark:border-white bg-transparent focus:outline-none focus:ring-2 focus:ring-black dark:focus:ring-white"
                    />
                  </div>
                  <div>
                    <label class="block text-xs font-bold tracking-[0.2em] uppercase mb-2">ZIP</label>
                    <input
                      type="text"
                      name="zip"
                      required
                      class="w-full px-4 py-3 border-2 border-black dark:border-white bg-transparent focus:outline-none focus:ring-2 focus:ring-black dark:focus:ring-white"
                    />
                  </div>
                </div>

                <div>
                  <label class="block text-xs font-bold tracking-[0.2em] uppercase mb-2">Country</label>
                  <select
                    name="country"
                    required
                    class="w-full px-4 py-3 border-2 border-black dark:border-white bg-transparent focus:outline-none focus:ring-2 focus:ring-black dark:focus:ring-white"
                  >
                    <option value="US">United States</option>
                    <option value="CA">Canada</option>
                    <option value="GB">United Kingdom</option>
                    <option value="AU">Australia</option>
                  </select>
                </div>
              </div>

              <div class="flex gap-4">
                <button
                  type="button"
                  onclick="prevStep()"
                  class="flex-1 px-6 py-4 border-2 border-black dark:border-white hover:bg-black dark:hover:bg-white hover:text-white dark:hover:text-black transition-colors"
                >
                  <span class="text-xs font-bold tracking-[0.2em] uppercase">Back to Cart</span>
                </button>
                <button
                  type="submit"
                  class="flex-1 px-6 py-4 bg-black dark:bg-white text-white dark:text-black border-2 border-black dark:border-white hover:opacity-80 transition-opacity"
                >
                  <span class="text-xs font-bold tracking-[0.2em] uppercase">Continue to Payment</span>
                </button>
              </div>
            </form>
          </div>

          <!-- Step 3: Payment -->
          <div id="step-payment" class="checkout-step hidden">
            <div class="mb-6">
              <h2 class="text-3xl font-light tracking-tight mb-2">Payment Method</h2>
              <p class="text-sm opacity-60">Select your preferred payment method</p>
            </div>

            <!-- Payment Methods -->
            <div class="space-y-4 mb-8">

              {x402Enabled && (
              <!-- X402 Crypto Payment (Primary) -->
              <div class="payment-method border-2 border-black dark:border-white p-6 hover:bg-black/5 dark:hover:bg-white/5 transition-colors cursor-pointer">
                <div class="flex items-start gap-4">
                  <input
                    type="radio"
                    name="payment"
                    value="x402"
                    id="payment-x402"
                    checked
                    class="mt-1"
                  />
                  <div class="flex-1">
                    <label for="payment-x402" class="cursor-pointer">
                      <div class="flex items-center justify-between mb-2">
                        <span class="text-sm font-bold tracking-[0.2em] uppercase">Crypto Payment (X402)</span>
                        <span class="text-xs px-3 py-1 border border-black dark:border-white font-bold tracking-wider">RECOMMENDED</span>
                      </div>
                      <p class="text-xs opacity-60 mb-3">Pay with USDC on Base. Fast, secure, and low fees (~$0.0001)</p>
                      <div class="flex gap-2">
                        <span class="text-xs px-2 py-1 bg-black dark:bg-white text-white dark:text-black">USDC</span>
                        <span class="text-xs px-2 py-1 bg-black dark:bg-white text-white dark:text-black">Base</span>
                      </div>
                    </label>
                  </div>
                </div>

                <!-- X402 Payment Details (shown when selected) -->
                <div id="x402-details" class="mt-6 pt-6 border-t-2 border-black dark:border-white">
                  <p class="text-xs opacity-60 mb-4">Connect your wallet to complete payment</p>
                  <button
                    type="button"
                    onclick="connectWallet()"
                    class="w-full px-6 py-4 bg-black dark:bg-white text-white dark:text-black border-2 border-black dark:border-white hover:opacity-80 transition-opacity"
                  >
                    <span class="text-xs font-bold tracking-[0.2em] uppercase">Connect Wallet</span>
                  </button>
                  <p class="text-xs text-center opacity-40 mt-3">Supports MetaMask, WalletConnect, Coinbase Wallet</p>
                </div>
              </div>
              )}

              {stripeEnabled && (
              <!-- Stripe Card Payment (Fallback) -->
              <div class="payment-method border-2 border-black dark:border-white p-6 hover:bg-black/5 dark:hover:bg-white/5 transition-colors cursor-pointer">
                <div class="flex items-start gap-4">
                  <input
                    type="radio"
                    name="payment"
                    value="stripe"
                    id="payment-stripe"
                  />
                  <div class="flex-1">
                    <label for="payment-stripe" class="cursor-pointer">
                      <div class="flex items-center justify-between mb-2">
                        <span class="text-sm font-bold tracking-[0.2em] uppercase">Credit Card (Stripe)</span>
                      </div>
                      <p class="text-xs opacity-60 mb-3">Pay with Visa, Mastercard, or American Express</p>
                      <div class="flex gap-2">
                        <svg class="h-6" viewBox="0 0 38 24" fill="none">
                          <rect width="38" height="24" rx="3" fill="#1A1F36"/>
                          <path d="M13 8h12v8H13V8z" fill="#FF5F00"/>
                          <path d="M14 12a5 5 0 015-5 5 5 0 00-3.5 8A5 5 0 0014 12z" fill="#EB001B"/>
                          <path d="M24 12a5 5 0 01-5 5 5 5 0 003.5-8A5 5 0 0124 12z" fill="#F79E1B"/>
                        </svg>
                      </div>
                    </label>
                  </div>
                </div>

                <!-- Stripe Card Details (shown when selected) -->
                <div id="stripe-details" class="mt-6 pt-6 border-t-2 border-black dark:border-white hidden">
                  <div class="space-y-4">
                    <div>
                      <label class="block text-xs font-bold tracking-[0.2em] uppercase mb-2">Card Number</label>
                      <input
                        type="text"
                        placeholder="4242 4242 4242 4242"
                        class="w-full px-4 py-3 border-2 border-black dark:border-white bg-transparent focus:outline-none focus:ring-2 focus:ring-black dark:focus:ring-white"
                      />
                    </div>
                    <div class="grid grid-cols-2 gap-4">
                      <div>
                        <label class="block text-xs font-bold tracking-[0.2em] uppercase mb-2">Expiry</label>
                        <input
                          type="text"
                          placeholder="MM / YY"
                          class="w-full px-4 py-3 border-2 border-black dark:border-white bg-transparent focus:outline-none focus:ring-2 focus:ring-black dark:focus:ring-white"
                        />
                      </div>
                      <div>
                        <label class="block text-xs font-bold tracking-[0.2em] uppercase mb-2">CVC</label>
                        <input
                          type="text"
                          placeholder="123"
                          class="w-full px-4 py-3 border-2 border-black dark:border-white bg-transparent focus:outline-none focus:ring-2 focus:ring-black dark:focus:ring-white"
                        />
                      </div>
                    </div>
                  </div>
                </div>
              </div>
              )}
            </div>

            <div class="flex gap-4">
              <button
                type="button"
                onclick="prevStep()"
                class="flex-1 px-6 py-4 border-2 border-black dark:border-white hover:bg-black dark:hover:bg-white hover:text-white dark:hover:text-black transition-colors"
              >
                <span class="text-xs font-bold tracking-[0.2em] uppercase">Back to Shipping</span>
              </button>
              <button
                type="button"
                onclick="completeOrder()"
                class="flex-1 px-6 py-4 bg-black dark:bg-white text-white dark:text-black border-2 border-black dark:border-white hover:opacity-80 transition-opacity"
              >
                <span class="text-xs font-bold tracking-[0.2em] uppercase">Complete Order</span>
              </button>
            </div>
          </div>
        </div>

        <!-- Right: Order Summary (Sticky) -->
        <div class="lg:col-span-1">
          <div class="border-2 border-black dark:border-white p-6 sticky top-6 space-y-6">
            <h3 class="text-sm font-bold tracking-[0.2em] uppercase border-b-2 border-black dark:border-white pb-4">Order Summary</h3>

            <div id="summary-items" class="space-y-4 max-h-64 overflow-y-auto">
              <!-- Summary items populated by JavaScript -->
            </div>

            <div class="space-y-3 border-t-2 border-black dark:border-white pt-4">
              <div class="flex justify-between text-sm">
                <span class="opacity-60">Subtotal</span>
                <span id="summary-subtotal" class="font-medium tabular-nums">$0.00</span>
              </div>
              <div class="flex justify-between text-sm">
                <span class="opacity-60">Shipping</span>
                <span class="font-bold tracking-wide">FREE</span>
              </div>
              <div class="flex justify-between text-sm">
                <span class="opacity-60">Tax</span>
                <span id="summary-tax" class="tabular-nums">Calculated</span>
              </div>
              <div class="flex justify-between pt-4 border-t-2 border-black dark:border-white">
                <span class="text-sm font-bold tracking-[0.2em] uppercase">Total</span>
                <span id="summary-total" class="text-2xl font-light tabular-nums">$0.00</span>
              </div>
            </div>

            <!-- Trust Badges -->
            <div class="space-y-2 border-t-2 border-black dark:border-white pt-4">
              <div class="flex items-center gap-2 text-xs opacity-60">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z" />
                </svg>
                <span>Secure checkout</span>
              </div>
              <div class="flex items-center gap-2 text-xs opacity-60">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
                </svg>
                <span>Free shipping</span>
              </div>
              <div class="flex items-center gap-2 text-xs opacity-60">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15" />
                </svg>
                <span>30-day returns</span>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Theme Toggle -->
    <ThemeToggle client:load />
  </div>

  <script>
    let currentStep = 1;
    const totalSteps = 3;

    // Mock cart data (would come from nanostores in real implementation)
    const cartItems = [
      {
        id: '1',
        name: 'Classic White Tee',
        price: 73,
        quantity: 2,
        image: 'https://i.imgur.com/Y54Bt8J.jpeg'
      },
      {
        id: '2',
        name: 'Sleek Modern Laptop',
        price: 1299,
        quantity: 1,
        image: 'https://i.imgur.com/QkIa5tT.jpeg'
      }
    ];

    function nextStep() {
      if (currentStep < totalSteps) {
        hideStep(currentStep);
        currentStep++;
        showStep(currentStep);
        updateProgress();
      }
    }

    function prevStep() {
      if (currentStep > 1) {
        hideStep(currentStep);
        currentStep--;
        showStep(currentStep);
        updateProgress();
      }
    }

    function hideStep(step: number) {
      const steps = ['cart', 'shipping', 'payment'];
      const el = document.getElementById(`step-${steps[step - 1]}`);
      if (el) el.classList.add('hidden');
    }

    function showStep(step: number) {
      const steps = ['cart', 'shipping', 'payment'];
      const el = document.getElementById(`step-${steps[step - 1]}`);
      if (el) el.classList.remove('hidden');
    }

    function updateProgress() {
      for (let i = 1; i <= totalSteps; i++) {
        const indicator = document.getElementById(`step-${i}`);
        if (!indicator) continue;

        if (i < currentStep) {
          // Completed step
          indicator.classList.remove('opacity-30', 'active');
          indicator.classList.add('bg-black', 'dark:bg-white', 'text-white', 'dark:text-black');
        } else if (i === currentStep) {
          // Active step
          indicator.classList.remove('opacity-30', 'bg-black', 'dark:bg-white', 'text-white', 'dark:text-black');
          indicator.classList.add('active');
        } else {
          // Upcoming step
          indicator.classList.remove('active', 'bg-black', 'dark:bg-white', 'text-white', 'dark:text-black');
          indicator.classList.add('opacity-30');
        }
      }
    }

    function renderCart() {
      const cartItemsEl = document.getElementById('cart-items');
      const summaryItemsEl = document.getElementById('summary-items');

      if (!cartItemsEl || !summaryItemsEl) return;

      // Render cart items
      cartItemsEl.innerHTML = cartItems.map(item => `
        <div class="flex gap-4 border-2 border-black dark:border-white p-4">
          <img src="${item.image}" alt="${item.name}" class="w-20 h-20 object-cover" />
          <div class="flex-1">
            <h3 class="font-medium mb-1">${item.name}</h3>
            <p class="text-sm opacity-60">Quantity: ${item.quantity}</p>
            <p class="text-sm font-bold mt-2">$${(item.price * item.quantity).toFixed(2)}</p>
          </div>
        </div>
      `).join('');

      // Render summary
      summaryItemsEl.innerHTML = cartItems.map(item => `
        <div class="flex gap-3">
          <img src="${item.image}" alt="${item.name}" class="w-12 h-12 object-cover border border-black dark:border-white" />
          <div class="flex-1 min-w-0">
            <p class="text-xs truncate">${item.name}</p>
            <p class="text-xs opacity-60">Qty: ${item.quantity}</p>
          </div>
          <span class="text-xs tabular-nums">$${(item.price * item.quantity).toFixed(2)}</span>
        </div>
      `).join('');

      updateOrderSummary();
    }

    function updateOrderSummary() {
      const subtotal = cartItems.reduce((sum, item) => sum + (item.price * item.quantity), 0);
      const tax = 0; // Calculated at checkout
      const total = subtotal + tax;

      const subtotalEl = document.getElementById('summary-subtotal');
      const taxEl = document.getElementById('summary-tax');
      const totalEl = document.getElementById('summary-total');

      if (subtotalEl) subtotalEl.textContent = `$${subtotal.toFixed(2)}`;
      if (taxEl) taxEl.textContent = tax > 0 ? `$${tax.toFixed(2)}` : 'Calculated';
      if (totalEl) totalEl.textContent = `$${total.toFixed(2)}`;
    }

    function connectWallet() {
      alert('Wallet connection would be implemented here with X402 protocol');
      // TODO: Implement X402 wallet connection
    }

    function completeOrder() {
      // TODO: Process payment and create order
      alert('Order completed! Redirecting to confirmation...');
      window.location.href = '/shop/order-confirmation?order=ORD-202501-001';
    }

    // Handle shipping form submission
    const shippingForm = document.getElementById('shipping-form');
    shippingForm?.addEventListener('submit', (e) => {
      e.preventDefault();
      nextStep();
    });

    // Handle payment method selection
    const paymentRadios = document.querySelectorAll('input[name="payment"]');
    paymentRadios.forEach(radio => {
      radio.addEventListener('change', (e) => {
        const value = (e.target as HTMLInputElement).value;
        document.getElementById('x402-details')?.classList.add('hidden');
        document.getElementById('stripe-details')?.classList.add('hidden');
        document.getElementById(`${value}-details`)?.classList.remove('hidden');
      });
    });

    // Expose functions globally
    (window as any).nextStep = nextStep;
    (window as any).prevStep = prevStep;
    (window as any).connectWallet = connectWallet;
    (window as any).completeOrder = completeOrder;

    // Initial render
    renderCart();
    updateProgress();
  </script>

  <style>
    .step-indicator.active {
      border-width: 3px;
    }

    .checkout-step {
      animation: fadeIn 0.3s ease-in;
    }

    @keyframes fadeIn {
      from {
        opacity: 0;
        transform: translateY(10px);
      }
      to {
        opacity: 1;
        transform: translateY(0);
      }
    }
  </style>
</ShopLayout>
