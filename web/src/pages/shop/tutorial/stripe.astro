---
/**
 * Stripe Setup Tutorial - ONE E-Commerce Package
 *
 * Complete guide to setting up Stripe payments.
 */

import ShopLayout from '@/layouts/ShopLayout.astro';
import { ThemeToggle } from '@/components/shop/ThemeToggle';
---

<ShopLayout
  title="Stripe Setup - ONE E-Commerce"
  description="Complete guide to setting up Stripe payments"
>
  <div class="bg-white dark:bg-black text-black dark:text-white min-h-screen">

    <!-- Header -->
    <section class="border-b-2 border-black dark:border-white">
      <div class="max-w-4xl mx-auto px-6 py-16">
        <a href="/shop/tutorial" class="inline-block text-sm font-bold tracking-wider uppercase hover:opacity-60 mb-8">
          ← Back to Tutorial
        </a>

        <div class="inline-block px-4 py-2 border-2 border-black dark:border-white mb-6">
          <span class="text-xs font-bold tracking-[0.3em] uppercase">Payment Setup</span>
        </div>

        <h1 class="text-5xl md:text-6xl font-light tracking-tight mb-6">
          Stripe Payments
        </h1>

        <p class="text-xl opacity-60">
          Accept card payments with Stripe Checkout - the easiest way to get paid online
        </p>
      </div>
    </section>

    <div class="max-w-4xl mx-auto px-6 py-12">

      <!-- Why Stripe -->
      <section class="mb-20">
        <h2 class="text-3xl font-light mb-8">Why Stripe?</h2>

        <div class="grid md:grid-cols-2 gap-8 mb-8">
          <div class="border-2 border-black dark:border-white p-6">
            <h3 class="text-lg font-light mb-4">Benefits</h3>
            <ul class="space-y-3 text-sm">
              <li class="flex items-start gap-3">
                <svg class="w-5 h-5 flex-shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
                </svg>
                <span>Accept all major cards (Visa, Mastercard, Amex)</span>
              </li>
              <li class="flex items-start gap-3">
                <svg class="w-5 h-5 flex-shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
                </svg>
                <span>Built-in fraud protection</span>
              </li>
              <li class="flex items-start gap-3">
                <svg class="w-5 h-5 flex-shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
                </svg>
                <span>No monthly fees (pay-per-transaction)</span>
              </li>
              <li class="flex items-start gap-3">
                <svg class="w-5 h-5 flex-shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
                </svg>
                <span>Hosted checkout page (PCI compliant)</span>
              </li>
              <li class="flex items-start gap-3">
                <svg class="w-5 h-5 flex-shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
                </svg>
                <span>Test mode for development</span>
              </li>
            </ul>
          </div>

          <div class="border-2 border-black dark:border-white p-6">
            <h3 class="text-lg font-light mb-4">Pricing</h3>
            <div class="space-y-4 text-sm">
              <div>
                <div class="font-bold mb-1">2.9% + 30¢</div>
                <div class="opacity-60">Per successful card charge</div>
              </div>
              <div>
                <div class="font-bold mb-1">$0</div>
                <div class="opacity-60">Monthly fee</div>
              </div>
              <div>
                <div class="font-bold mb-1">$0</div>
                <div class="opacity-60">Setup fee</div>
              </div>
              <div class="pt-4 border-t border-black dark:border-white">
                <div class="text-xs opacity-60">
                  Example: $100 sale = $97.10 in your account
                </div>
              </div>
            </div>
          </div>
        </div>
      </section>

      <!-- Step 1: Create Account -->
      <section class="mb-20">
        <div class="flex items-start gap-6 mb-8">
          <div class="flex-shrink-0 w-16 h-16 border-2 border-black dark:border-white flex items-center justify-center text-2xl font-light">
            1
          </div>
          <div class="flex-1">
            <h2 class="text-3xl font-light mb-3">Create Stripe Account</h2>
            <p class="text-lg opacity-60">Sign up for a free Stripe account</p>
          </div>
        </div>

        <div class="pl-22 space-y-6">
          <div class="space-y-4">
            <div class="flex items-start gap-4">
              <div class="flex-shrink-0 w-8 h-8 border border-black dark:border-white flex items-center justify-center text-sm">
                1
              </div>
              <div class="flex-1">
                <p class="text-sm mb-2">Visit <a href="https://stripe.com" target="_blank" class="underline font-bold">stripe.com</a> and click "Start now"</p>
              </div>
            </div>

            <div class="flex items-start gap-4">
              <div class="flex-shrink-0 w-8 h-8 border border-black dark:border-white flex items-center justify-center text-sm">
                2
              </div>
              <div class="flex-1">
                <p class="text-sm mb-2">Enter your email, name, and country</p>
              </div>
            </div>

            <div class="flex items-start gap-4">
              <div class="flex-shrink-0 w-8 h-8 border border-black dark:border-white flex items-center justify-center text-sm">
                3
              </div>
              <div class="flex-1">
                <p class="text-sm mb-2">Verify your email address</p>
              </div>
            </div>

            <div class="flex items-start gap-4">
              <div class="flex-shrink-0 w-8 h-8 border border-black dark:border-white flex items-center justify-center text-sm">
                4
              </div>
              <div class="flex-1">
                <p class="text-sm mb-2">Complete business information (can skip for testing)</p>
              </div>
            </div>
          </div>

          <div class="border-l-4 border-black dark:border-white pl-6 py-4 bg-black/5 dark:bg-white/5">
            <p class="text-sm">
              <strong>Note:</strong> You can start testing immediately without completing business verification.
            </p>
          </div>
        </div>
      </section>

      <!-- Step 2: Get API Keys -->
      <section class="mb-20">
        <div class="flex items-start gap-6 mb-8">
          <div class="flex-shrink-0 w-16 h-16 border-2 border-black dark:border-white flex items-center justify-center text-2xl font-light">
            2
          </div>
          <div class="flex-1">
            <h2 class="text-3xl font-light mb-3">Get API Keys</h2>
            <p class="text-lg opacity-60">Copy your Stripe API keys</p>
          </div>
        </div>

        <div class="pl-22 space-y-6">
          <div class="space-y-4">
            <div class="flex items-start gap-4">
              <div class="flex-shrink-0 w-8 h-8 border border-black dark:border-white flex items-center justify-center text-sm">
                1
              </div>
              <div class="flex-1">
                <p class="text-sm mb-2">Log into your Stripe Dashboard at <a href="https://dashboard.stripe.com" target="_blank" class="underline font-bold">dashboard.stripe.com</a></p>
              </div>
            </div>

            <div class="flex items-start gap-4">
              <div class="flex-shrink-0 w-8 h-8 border border-black dark:border-white flex items-center justify-center text-sm">
                2
              </div>
              <div class="flex-1">
                <p class="text-sm mb-2">Make sure you're in <strong>Test Mode</strong> (toggle in top-right corner)</p>
              </div>
            </div>

            <div class="flex items-start gap-4">
              <div class="flex-shrink-0 w-8 h-8 border border-black dark:border-white flex items-center justify-center text-sm">
                3
              </div>
              <div class="flex-1">
                <p class="text-sm mb-2">Click "Developers" → "API keys" in the left sidebar</p>
              </div>
            </div>

            <div class="flex items-start gap-4">
              <div class="flex-shrink-0 w-8 h-8 border border-black dark:border-white flex items-center justify-center text-sm">
                4
              </div>
              <div class="flex-1">
                <p class="text-sm mb-2">Copy both keys:</p>
                <ul class="mt-2 space-y-2 text-sm">
                  <li class="flex items-center gap-2 pl-4">
                    <span class="opacity-60">→</span>
                    <strong>Publishable key</strong> (starts with <code class="text-xs bg-black/10 dark:bg-white/10 px-1">pk_test_</code>)
                  </li>
                  <li class="flex items-center gap-2 pl-4">
                    <span class="opacity-60">→</span>
                    <strong>Secret key</strong> (starts with <code class="text-xs bg-black/10 dark:bg-white/10 px-1">sk_test_</code>)
                  </li>
                </ul>
              </div>
            </div>
          </div>

          <div class="border-2 border-red-500 p-6 bg-red-50 dark:bg-red-950">
            <h4 class="text-sm font-bold mb-2 text-red-700 dark:text-red-300">⚠️ Security Warning</h4>
            <p class="text-sm text-red-700 dark:text-red-300">
              Never commit your <strong>Secret Key</strong> to GitHub or share it publicly. It should only be in your <code class="text-xs bg-red-100 dark:bg-red-900 px-1">.env</code> file (which is gitignored).
            </p>
          </div>
        </div>
      </section>

      <!-- Step 3: Configure Environment -->
      <section class="mb-20">
        <div class="flex items-start gap-6 mb-8">
          <div class="flex-shrink-0 w-16 h-16 border-2 border-black dark:border-white flex items-center justify-center text-2xl font-light">
            3
          </div>
          <div class="flex-1">
            <h2 class="text-3xl font-light mb-3">Add Keys to .env</h2>
            <p class="text-lg opacity-60">Configure your environment variables</p>
          </div>
        </div>

        <div class="pl-22 space-y-6">
          <div>
            <h3 class="text-sm font-bold tracking-wider uppercase mb-3">Create/Edit .env File</h3>
            <div class="bg-black text-white dark:bg-white dark:text-black p-6 font-mono text-sm overflow-x-auto">
              <div class="space-y-2">
                <div class="opacity-60"># Stripe Configuration</div>
                <div>STRIPE_SECRET_KEY=sk_test_paste_your_secret_key_here</div>
                <div>PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_paste_your_publishable_key_here</div>
              </div>
            </div>
          </div>

          <div class="border-l-4 border-black dark:border-white pl-6 py-4 bg-black/5 dark:bg-white/5">
            <p class="text-sm mb-2">
              <strong>Important:</strong> Make sure your <code class="text-xs bg-black/10 dark:bg-white/10 px-1">.env</code> file is in your <code class="text-xs bg-black/10 dark:bg-white/10 px-1">.gitignore</code>:
            </p>
            <div class="mt-2 bg-white dark:bg-black border border-black dark:border-white p-3 font-mono text-xs">
              <div>.env</div>
              <div>.env.local</div>
              <div>.env.*.local</div>
            </div>
          </div>
        </div>
      </section>

      <!-- Step 4: Test Payment -->
      <section class="mb-20">
        <div class="flex items-start gap-6 mb-8">
          <div class="flex-shrink-0 w-16 h-16 border-2 border-black dark:border-white flex items-center justify-center text-2xl font-light">
            4
          </div>
          <div class="flex-1">
            <h2 class="text-3xl font-light mb-3">Test a Payment</h2>
            <p class="text-lg opacity-60">Make a test purchase</p>
          </div>
        </div>

        <div class="pl-22 space-y-6">
          <div>
            <h3 class="text-sm font-bold tracking-wider uppercase mb-3">Test Card Numbers</h3>
            <div class="space-y-4">
              <div class="border-2 border-black dark:border-white p-4">
                <div class="font-mono text-sm mb-2">4242 4242 4242 4242</div>
                <div class="text-xs opacity-60">Successful payment</div>
              </div>

              <div class="border-2 border-black dark:border-white p-4">
                <div class="font-mono text-sm mb-2">4000 0025 0000 3155</div>
                <div class="text-xs opacity-60">Requires 3D Secure authentication</div>
              </div>

              <div class="border-2 border-black dark:border-white p-4">
                <div class="font-mono text-sm mb-2">4000 0000 0000 9995</div>
                <div class="text-xs opacity-60">Card declined (insufficient funds)</div>
              </div>
            </div>

            <div class="mt-4 text-sm opacity-60">
              <p class="mb-2"><strong>For all test cards:</strong></p>
              <ul class="space-y-1 pl-4">
                <li>• Expiry: Any future date (e.g., 12/34)</li>
                <li>• CVC: Any 3 digits (e.g., 123)</li>
                <li>• ZIP: Any 5 digits (e.g., 12345)</li>
              </ul>
            </div>
          </div>

          <div>
            <h3 class="text-sm font-bold tracking-wider uppercase mb-3">Try It Now</h3>
            <div class="space-y-2">
              <div class="flex items-start gap-2">
                <span class="opacity-60">1.</span>
                <span class="text-sm">Go to <a href="/shop/checkout" class="underline font-bold">/shop/checkout</a></span>
              </div>
              <div class="flex items-start gap-2">
                <span class="opacity-60">2.</span>
                <span class="text-sm">Select "Credit or Debit Card"</span>
              </div>
              <div class="flex items-start gap-2">
                <span class="opacity-60">3.</span>
                <span class="text-sm">Enter your email</span>
              </div>
              <div class="flex items-start gap-2">
                <span class="opacity-60">4.</span>
                <span class="text-sm">Click "Continue to Stripe Checkout"</span>
              </div>
              <div class="flex items-start gap-2">
                <span class="opacity-60">5.</span>
                <span class="text-sm">Use test card <code class="text-xs bg-black/10 dark:bg-white/10 px-1">4242 4242 4242 4242</code></span>
              </div>
            </div>

            <a
              href="/shop/checkout"
              class="inline-block mt-6 px-8 py-4 bg-black dark:bg-white text-white dark:text-black border-2 border-black dark:border-white hover:opacity-80 transition-opacity"
            >
              <span class="text-xs font-bold tracking-[0.3em] uppercase">Test Checkout Now →</span>
            </a>
          </div>
        </div>
      </section>

      <!-- Step 5: Production -->
      <section class="mb-20">
        <div class="flex items-start gap-6 mb-8">
          <div class="flex-shrink-0 w-16 h-16 border-2 border-black dark:border-white flex items-center justify-center text-2xl font-light">
            5
          </div>
          <div class="flex-1">
            <h2 class="text-3xl font-light mb-3">Go Live</h2>
            <p class="text-lg opacity-60">Activate your account for real payments</p>
          </div>
        </div>

        <div class="pl-22 space-y-6">
          <div class="space-y-4">
            <div class="flex items-start gap-4">
              <div class="flex-shrink-0 w-8 h-8 border border-black dark:border-white flex items-center justify-center text-sm">
                1
              </div>
              <div class="flex-1">
                <p class="text-sm mb-2">Complete Stripe account verification (business info, bank details)</p>
              </div>
            </div>

            <div class="flex items-start gap-4">
              <div class="flex-shrink-0 w-8 h-8 border border-black dark:border-white flex items-center justify-center text-sm">
                2
              </div>
              <div class="flex-1">
                <p class="text-sm mb-2">Switch to <strong>Live Mode</strong> in Stripe Dashboard</p>
              </div>
            </div>

            <div class="flex items-start gap-4">
              <div class="flex-shrink-0 w-8 h-8 border border-black dark:border-white flex items-center justify-center text-sm">
                3
              </div>
              <div class="flex-1">
                <p class="text-sm mb-2">Get your <strong>Live API keys</strong> (starts with <code class="text-xs bg-black/10 dark:bg-white/10 px-1">pk_live_</code> and <code class="text-xs bg-black/10 dark:bg-white/10 px-1">sk_live_</code>)</p>
              </div>
            </div>

            <div class="flex items-start gap-4">
              <div class="flex-shrink-0 w-8 h-8 border border-black dark:border-white flex items-center justify-center text-sm">
                4
              </div>
              <div class="flex-1">
                <p class="text-sm mb-2">Update your production <code class="text-xs bg-black/10 dark:bg-white/10 px-1">.env</code> with live keys</p>
              </div>
            </div>

            <div class="flex items-start gap-4">
              <div class="flex-shrink-0 w-8 h-8 border border-black dark:border-white flex items-center justify-center text-sm">
                5
              </div>
              <div class="flex-1">
                <p class="text-sm mb-2">Deploy to production and start accepting real payments!</p>
              </div>
            </div>
          </div>

          <div class="border-l-4 border-black dark:border-white pl-6 py-4 bg-black/5 dark:bg-white/5">
            <p class="text-sm">
              <strong>Tip:</strong> Keep test keys in your local <code class="text-xs bg-black/10 dark:bg-white/10 px-1">.env</code> and use live keys only in production environment variables.
            </p>
          </div>
        </div>
      </section>

      <!-- Resources -->
      <section class="border-t-2 border-black dark:border-white pt-12">
        <h2 class="text-3xl font-light mb-8">Additional Resources</h2>

        <div class="grid md:grid-cols-2 gap-6">
          <a
            href="https://stripe.com/docs"
            target="_blank"
            class="border-2 border-black dark:border-white p-6 hover:bg-black hover:text-white dark:hover:bg-white dark:hover:text-black transition-all group"
          >
            <h3 class="text-lg font-light mb-2">Stripe Documentation →</h3>
            <p class="text-sm opacity-60 group-hover:opacity-100">
              Official Stripe docs with detailed guides
            </p>
          </a>

          <a
            href="https://stripe.com/docs/testing"
            target="_blank"
            class="border-2 border-black dark:border-white p-6 hover:bg-black hover:text-white dark:hover:bg-white dark:hover:text-black transition-all group"
          >
            <h3 class="text-lg font-light mb-2">Test Card Numbers →</h3>
            <p class="text-sm opacity-60 group-hover:opacity-100">
              Complete list of test cards for different scenarios
            </p>
          </a>

          <a
            href="https://dashboard.stripe.com/test/webhooks"
            target="_blank"
            class="border-2 border-black dark:border-white p-6 hover:bg-black hover:text-white dark:hover:bg-white dark:hover:text-black transition-all group"
          >
            <h3 class="text-lg font-light mb-2">Webhooks (Advanced) →</h3>
            <p class="text-sm opacity-60 group-hover:opacity-100">
              Set up webhooks for order fulfillment
            </p>
          </a>

          <a
            href="/shop/checkout"
            class="border-2 border-black dark:border-white p-6 hover:bg-black hover:text-white dark:hover:bg-white dark:hover:text-black transition-all group"
          >
            <h3 class="text-lg font-light mb-2">Try Demo Checkout →</h3>
            <p class="text-sm opacity-60 group-hover:opacity-100">
              Test the checkout flow with Stripe
            </p>
          </a>
        </div>
      </section>

      <!-- Navigation -->
      <section class="mt-20 flex justify-between items-center">
        <a
          href="/shop/tutorial"
          class="px-6 py-3 border-2 border-black dark:border-white hover:bg-black hover:text-white dark:hover:bg-white dark:hover:text-black transition-colors"
        >
          <span class="text-xs font-bold tracking-wider uppercase">← Back to Tutorial</span>
        </a>

        <a
          href="/shop/tutorial/x402"
          class="px-6 py-3 bg-black dark:bg-white text-white dark:text-black border-2 border-black dark:border-white hover:opacity-80 transition-opacity"
        >
          <span class="text-xs font-bold tracking-wider uppercase">X402 Setup →</span>
        </a>
      </section>

    </div>

    <!-- Theme Toggle -->
    <ThemeToggle client:load />

  </div>
</ShopLayout>
