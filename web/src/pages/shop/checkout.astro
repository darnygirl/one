---
/**
 * Complete Checkout Page - ONE Platform E-Commerce
 *
 * Features:
 * - Full Stripe integration for card payments
 * - X402 crypto payments as alternative
 * - Multi-step checkout flow
 * - Guest checkout support
 * - Real-time order summary
 * - Mobile-responsive design
 *
 * Payment Methods:
 * 1. Stripe Checkout (Primary) - Credit/debit cards
 * 2. X402 Protocol (Alternative) - USDC on Base network
 */

import ShopLayout from '@/layouts/ShopLayout.astro';
import { ProductHeader } from '@/components/shop/ProductHeader';
import { ThemeToggle } from '@/components/shop/ThemeToggle';

// Check if Stripe is configured
const stripeSecretKey = import.meta.env.STRIPE_SECRET_KEY;
const stripeEnabled = Boolean(stripeSecretKey);

// Check if X402 is enabled
const x402Enabled = import.meta.env.PUBLIC_X402_ENABLED === 'true';

// Import Stripe only if enabled
let stripe: any = null;
if (stripeEnabled) {
  const { default: Stripe } = await import('stripe');
  stripe = new Stripe(stripeSecretKey);
}

// Handle Stripe Checkout Session Creation (POST request)
if (stripeEnabled && Astro.request.method === 'POST') {
  try {
    const formData = await Astro.request.formData();
    const cartDataString = formData.get('cartData')?.toString();
    const customerEmail = formData.get('email')?.toString();
    const shippingData = formData.get('shippingData')?.toString();

    if (!cartDataString) {
      return new Response(JSON.stringify({ error: 'No cart data provided' }), {
        status: 400,
        headers: { 'Content-Type': 'application/json' }
      });
    }

    // Parse cart data
    const cartItems = JSON.parse(cartDataString);

    // Validate cart items
    if (!Array.isArray(cartItems) || cartItems.length === 0) {
      return new Response(JSON.stringify({ error: 'Cart is empty' }), {
        status: 400,
        headers: { 'Content-Type': 'application/json' }
      });
    }

    // Create line items for Stripe
    const lineItems = cartItems.map((item: any) => ({
      price_data: {
        currency: 'usd',
        product_data: {
          name: item.name,
          description: item.description || '',
          images: item.image ? [item.image] : [],
        },
        unit_amount: Math.round(item.price * 100), // Convert to cents
      },
      quantity: item.quantity,
    }));

    // Create Stripe Checkout Session
    const session = await stripe.checkout.sessions.create({
      payment_method_types: ['card'],
      line_items: lineItems,
      mode: 'payment',
      success_url: `${Astro.url.origin}/shop/order-confirmation?session_id={CHECKOUT_SESSION_ID}`,
      cancel_url: `${Astro.url.origin}/shop/checkout`,
      customer_email: customerEmail || undefined,
      shipping_address_collection: {
        allowed_countries: ['US', 'CA', 'GB', 'AU'],
      },
      metadata: {
        orderType: 'ecommerce',
        shippingData: shippingData || '',
      },
    });

    // Return the checkout URL as JSON
    return new Response(
      JSON.stringify({ url: session.url }),
      {
        status: 200,
        headers: {
          'Content-Type': 'application/json',
        },
      }
    );
  } catch (error) {
    console.error('Stripe checkout error:', error);
    return new Response(
      JSON.stringify({ error: 'Payment processing failed' }),
      {
        status: 500,
        headers: { 'Content-Type': 'application/json' }
      }
    );
  }
}
---

<ShopLayout title="Checkout - ONE Platform" description="Complete your purchase securely">
  <div class="bg-white dark:bg-black text-black dark:text-white min-h-screen">

    <!-- Header -->
    <ProductHeader client:load productName="Checkout" />

    <!-- Main Content -->
    <section class="max-w-6xl mx-auto px-6 py-12">

      <!-- Page Title -->
      <div class="mb-12 text-center">
        <h1 class="text-4xl md:text-5xl font-light tracking-tight mb-4">Checkout</h1>
        <p class="text-base opacity-60">Complete your purchase securely</p>
      </div>

      <div class="grid lg:grid-cols-3 gap-12">

        <!-- Left: Checkout Forms -->
        <div class="lg:col-span-2 space-y-8">

          <!-- Payment Method Selection -->
          <div class="border-2 border-black dark:border-white p-8">
            <h2 class="text-2xl font-light tracking-tight mb-6">Select Payment Method</h2>

            <div class="space-y-6">

              {stripeEnabled && (
              <!-- Stripe Payment Card -->
              <div class="border-2 border-black dark:border-white p-6 hover:bg-black/5 dark:hover:bg-white/5 transition-colors cursor-pointer">
                <div class="flex items-start gap-4">
                  <input
                    type="radio"
                    name="payment-method"
                    value="stripe"
                    id="payment-stripe"
                    checked
                    class="mt-1"
                  />
                  <div class="flex-1">
                    <label for="payment-stripe" class="cursor-pointer">
                      <div class="flex items-center justify-between mb-3">
                        <span class="text-lg font-medium">Credit or Debit Card</span>
                        <span class="text-xs px-3 py-1 border border-black dark:border-white font-bold tracking-wider">RECOMMENDED</span>
                      </div>
                      <p class="text-sm opacity-60 mb-4">Fast, secure payment via Stripe. All major cards accepted.</p>

                      <!-- Card Icons -->
                      <div class="flex gap-3">
                        <div class="h-8 w-12 border border-black dark:border-white rounded flex items-center justify-center text-xs font-bold">
                          VISA
                        </div>
                        <div class="h-8 w-12 border border-black dark:border-white rounded flex items-center justify-center text-xs font-bold">
                          MC
                        </div>
                        <div class="h-8 w-12 border border-black dark:border-white rounded flex items-center justify-center text-xs font-bold">
                          AMEX
                        </div>
                      </div>
                    </label>

                    <!-- Stripe Checkout Form -->
                    <div id="stripe-checkout-form" class="mt-6 pt-6 border-t-2 border-black dark:border-white">
                      <form id="stripe-form" class="space-y-6">
                        <!-- Email -->
                        <div>
                          <label class="block text-xs font-bold tracking-[0.2em] uppercase mb-2">Email</label>
                          <input
                            type="email"
                            id="stripe-email"
                            name="email"
                            required
                            class="w-full px-4 py-3 border-2 border-black dark:border-white bg-transparent focus:outline-none focus:ring-2 focus:ring-black dark:focus:ring-white"
                            placeholder="your@email.com"
                          />
                        </div>

                        <!-- Checkout Button -->
                        <button
                          type="submit"
                          id="stripe-checkout-btn"
                          class="w-full px-8 py-4 bg-black dark:bg-white text-white dark:text-black border-2 border-black dark:border-white hover:opacity-80 transition-opacity disabled:opacity-50 disabled:cursor-not-allowed"
                        >
                          <span class="text-xs font-bold tracking-[0.3em] uppercase">
                            Continue to Stripe Checkout
                          </span>
                        </button>

                        <p class="text-xs text-center opacity-60">
                          You'll be redirected to Stripe's secure checkout page
                        </p>
                      </form>
                    </div>
                  </div>
                </div>
              </div>
              )}

              {x402Enabled && (
              <!-- X402 Crypto Payment Card -->
              <div class="border-2 border-black dark:border-white p-6 hover:bg-black/5 dark:hover:bg-white/5 transition-colors cursor-pointer">
                <div class="flex items-start gap-4">
                  <input
                    type="radio"
                    name="payment-method"
                    value="x402"
                    id="payment-x402"
                    class="mt-1"
                  />
                  <div class="flex-1">
                    <label for="payment-x402" class="cursor-pointer">
                      <div class="flex items-center justify-between mb-3">
                        <span class="text-lg font-medium">Crypto Payment (USDC)</span>
                        <span class="text-xs px-3 py-1 bg-black dark:bg-white text-white dark:text-black font-bold tracking-wider">
                          LOW FEES
                        </span>
                      </div>
                      <p class="text-sm opacity-60 mb-4">
                        Pay with USDC on Base network. Ultra-low fees (~$0.0001) and instant settlement.
                      </p>

                      <!-- Crypto Badges -->
                      <div class="flex gap-2">
                        <span class="text-xs px-3 py-1 bg-black dark:bg-white text-white dark:text-black font-bold">USDC</span>
                        <span class="text-xs px-3 py-1 bg-black dark:bg-white text-white dark:text-black font-bold">BASE</span>
                        <span class="text-xs px-3 py-1 border border-black dark:border-white font-bold">X402</span>
                      </div>
                    </label>

                    <!-- X402 Checkout (Hidden by default) -->
                    <div id="x402-checkout-form" class="mt-6 pt-6 border-t-2 border-black dark:border-white hidden">
                      <!-- X402 Placeholder - Component loaded dynamically via loadX402Component() -->
                      <div id="x402-component-mount">
                        <div class="text-center p-8 border-2 border-black dark:border-white bg-black/5 dark:bg-white/5">
                          <div class="mb-4">
                            <svg class="w-12 h-12 mx-auto opacity-40" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 9V7a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2m2 4h10a2 2 0 002-2v-6a2 2 0 00-2-2H9a2 2 0 00-2 2v6a2 2 0 002 2zm7-5a2 2 0 11-4 0 2 2 0 014 0z" />
                            </svg>
                          </div>
                          <p class="text-sm font-bold tracking-wide mb-2">X402 Crypto Payment</p>
                          <p class="text-xs opacity-60 mb-4">
                            Install web3 dependencies to enable crypto payments
                          </p>
                          <div class="space-y-1 text-xs opacity-40">
                            <p>Required packages:</p>
                            <p class="font-mono">bun add wagmi viem @rainbow-me/rainbowkit</p>
                          </div>
                          <a
                            href="https://github.com/one-platform/one-ecommerce"
                            target="_blank"
                            class="inline-block mt-4 text-xs underline hover:opacity-60"
                          >
                            View Setup Guide →
                          </a>
                        </div>
                      </div>
                    </div>
                  </div>
                </div>
              </div>
              )}

              {!stripeEnabled && !x402Enabled && (
              <!-- No Payment Methods Configured -->
              <div class="border-2 border-red-500 p-8 text-center">
                <p class="text-red-500 font-bold mb-2">No Payment Methods Configured</p>
                <p class="text-sm opacity-60">
                  Please configure Stripe or X402 to enable payments.
                </p>
                <div class="mt-4 text-xs opacity-40">
                  <p>Add to .env:</p>
                  <p class="font-mono mt-2">STRIPE_SECRET_KEY=sk_xxx</p>
                  <p class="font-mono">PUBLIC_X402_ENABLED=true</p>
                </div>
              </div>
              )}
            </div>
          </div>

          <!-- Trust Badges -->
          <div class="border border-black dark:border-white p-6">
            <div class="grid md:grid-cols-3 gap-6 text-center">
              <div class="flex flex-col items-center gap-2">
                <svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z" />
                </svg>
                <span class="text-xs font-bold tracking-wide">Secure Checkout</span>
              </div>
              <div class="flex flex-col items-center gap-2">
                <svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
                </svg>
                <span class="text-xs font-bold tracking-wide">Free Shipping</span>
              </div>
              <div class="flex flex-col items-center gap-2">
                <svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15" />
                </svg>
                <span class="text-xs font-bold tracking-wide">30-Day Returns</span>
              </div>
            </div>
          </div>
        </div>

        <!-- Right: Order Summary (Sticky) -->
        <div class="lg:col-span-1">
          <div class="border-2 border-black dark:border-white p-6 sticky top-6 space-y-6">
            <h3 class="text-sm font-bold tracking-[0.2em] uppercase border-b-2 border-black dark:border-white pb-4">
              Order Summary
            </h3>

            <div id="order-items" class="space-y-4 max-h-96 overflow-y-auto">
              <!-- Order items populated by JavaScript -->
              <div class="text-center py-8 opacity-40">
                <p class="text-sm">Loading cart...</p>
              </div>
            </div>

            <div class="space-y-3 border-t-2 border-black dark:border-white pt-4">
              <div class="flex justify-between text-sm">
                <span class="opacity-60">Subtotal</span>
                <span id="order-subtotal" class="font-medium tabular-nums">$0.00</span>
              </div>
              <div class="flex justify-between text-sm">
                <span class="opacity-60">Shipping</span>
                <span class="font-bold tracking-wide">FREE</span>
              </div>
              <div class="flex justify-between text-sm">
                <span class="opacity-60">Tax</span>
                <span class="tabular-nums opacity-60">Calculated at checkout</span>
              </div>
              <div class="flex justify-between pt-4 border-t-2 border-black dark:border-white">
                <span class="text-sm font-bold tracking-[0.2em] uppercase">Total</span>
                <span id="order-total" class="text-2xl font-light tabular-nums">$0.00</span>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Theme Toggle -->
    <ThemeToggle client:load />
  </div>

  <script>
    // Mock cart data (in real implementation, this would come from nanostores)
    const cartItems = [
      {
        id: '1',
        name: 'Premium Wireless Headphones',
        description: 'High-quality noise-canceling headphones',
        price: 299.99,
        quantity: 1,
        image: 'https://i.imgur.com/ZANVnHE.jpeg'
      },
      {
        id: '2',
        name: 'Sleek Laptop Bag',
        description: 'Professional laptop bag with multiple compartments',
        price: 79.99,
        quantity: 2,
        image: 'https://i.imgur.com/Y54Bt8J.jpeg'
      }
    ];

    // Render order summary
    function renderOrderSummary() {
      const orderItemsEl = document.getElementById('order-items');
      if (!orderItemsEl) return;

      if (cartItems.length === 0) {
        orderItemsEl.innerHTML = `
          <div class="text-center py-8">
            <p class="text-sm opacity-60 mb-4">Your cart is empty</p>
            <a href="/shop/marketplace" class="text-sm underline">Continue Shopping</a>
          </div>
        `;
        return;
      }

      orderItemsEl.innerHTML = cartItems.map(item => `
        <div class="flex gap-3">
          <img src="${item.image}" alt="${item.name}" class="w-16 h-16 object-cover border border-black dark:border-white" />
          <div class="flex-1 min-w-0">
            <p class="text-sm font-medium truncate">${item.name}</p>
            <p class="text-xs opacity-60">Qty: ${item.quantity}</p>
            <p class="text-sm font-bold mt-1 tabular-nums">$${(item.price * item.quantity).toFixed(2)}</p>
          </div>
        </div>
      `).join('');

      updateOrderTotals();
    }

    function updateOrderTotals() {
      const subtotal = cartItems.reduce((sum, item) => sum + (item.price * item.quantity), 0);
      const total = subtotal; // Tax calculated at Stripe checkout

      const subtotalEl = document.getElementById('order-subtotal');
      const totalEl = document.getElementById('order-total');

      if (subtotalEl) subtotalEl.textContent = `$${subtotal.toFixed(2)}`;
      if (totalEl) totalEl.textContent = `$${total.toFixed(2)}`;
    }

    // Handle payment method selection
    const paymentRadios = document.querySelectorAll('input[name="payment-method"]');
    paymentRadios.forEach(radio => {
      radio.addEventListener('change', (e) => {
        const value = (e.target as HTMLInputElement).value;

        // Hide all payment forms
        const stripeForm = document.getElementById('stripe-checkout-form');
        const x402Form = document.getElementById('x402-checkout-form');

        if (stripeForm) stripeForm.classList.add('hidden');
        if (x402Form) x402Form.classList.add('hidden');

        // Show selected payment form
        if (value === 'stripe' && stripeForm) {
          stripeForm.classList.remove('hidden');
        } else if (value === 'x402' && x402Form) {
          x402Form.classList.remove('hidden');
          loadX402Component();
        }
      });
    });

    // Handle Stripe checkout form submission
    const stripeForm = document.getElementById('stripe-form');
    stripeForm?.addEventListener('submit', async (e) => {
      e.preventDefault();

      const submitBtn = document.getElementById('stripe-checkout-btn') as HTMLButtonElement;
      if (!submitBtn) return;

      // Disable button
      submitBtn.disabled = true;
      submitBtn.innerHTML = '<span class="text-xs font-bold tracking-[0.3em] uppercase">Processing...</span>';

      try {
        const formData = new FormData();
        const emailInput = document.getElementById('stripe-email') as HTMLInputElement;

        formData.append('email', emailInput?.value || '');
        formData.append('cartData', JSON.stringify(cartItems));

        const response = await fetch(window.location.pathname, {
          method: 'POST',
          body: formData,
        });

        if (!response.ok) {
          throw new Error('Payment processing failed');
        }

        const data = await response.json();

        if (data.url) {
          // Redirect to Stripe Checkout
          window.location.href = data.url;
        } else {
          throw new Error('No checkout URL received');
        }
      } catch (error) {
        console.error('Checkout error:', error);
        alert('Payment processing failed. Please try again.');

        // Re-enable button
        submitBtn.disabled = false;
        submitBtn.innerHTML = '<span class="text-xs font-bold tracking-[0.3em] uppercase">Continue to Stripe Checkout</span>';
      }
    });

    // Load X402 component dynamically
    function loadX402Component() {
      const mountEl = document.getElementById('x402-component-mount');
      if (!mountEl) return;

      // In a real implementation, you would mount the React component here
      // For now, just show a placeholder
      mountEl.innerHTML = `
        <div class="text-center p-8 border-2 border-black dark:border-white">
          <p class="text-sm opacity-60 mb-4">X402 Crypto Payment</p>
          <p class="text-xs opacity-40">Connect your wallet to continue</p>
        </div>
      `;
    }

    // Initial render
    renderOrderSummary();

    // Auto-select Stripe if enabled and show its form
    const stripeRadio = document.getElementById('payment-stripe') as HTMLInputElement;
    if (stripeRadio && stripeRadio.checked) {
      const stripeForm = document.getElementById('stripe-checkout-form');
      if (stripeForm) stripeForm.classList.remove('hidden');
    }
  </script>
</ShopLayout>
