---

<Layout title="Visualization Components Demo">
  <div class="container mx-auto py-12 px-4 space-y-12">
    <div class="space-y-2">
      <h1 class="text-4xl font-bold">Advanced Visualization Components</h1>
      <p class="text-muted-foreground text-lg">
        Powerful data visualization tools for the 6-dimension ontology
      </p>
    </div>

    <!-- Heatmap Chart -->
    <section class="space-y-4">
      <div>
        <h2 class="text-2xl font-semibold mb-2">Heatmap Chart</h2>
        <p class="text-muted-foreground">
          Visualize activity patterns across two dimensions with color-coded intensity.
        </p>
      </div>
      <HeatmapChart
        client:load
        data={heatmapData}
        title="User Activity by Day and Hour"
        cellWidth={80}
        cellHeight={50}
        exportable={true}
      />
      <div class="p-4 bg-muted rounded-lg">
        <h3 class="font-medium mb-2">Features:</h3>
        <ul class="list-disc list-inside space-y-1 text-sm text-muted-foreground">
          <li>Interactive zoom controls</li>
          <li>Configurable color scales</li>
          <li>Cell tooltips on hover</li>
          <li>Export to CSV and PNG</li>
          <li>Responsive design</li>
        </ul>
      </div>
    </section>

    <!-- Network Diagram -->
    <section class="space-y-4">
      <div>
        <h2 class="text-2xl font-semibold mb-2">Network Diagram</h2>
        <p class="text-muted-foreground">
          Visualize relationships and connections with force-directed graphs.
        </p>
      </div>
      <NetworkDiagram
        client:load
        nodes={networkNodes}
        links={networkLinks}
        title="User Connection Network"
        showClusters={true}
        layoutType="force"
      />
      <div class="p-4 bg-muted rounded-lg">
        <h3 class="font-medium mb-2">Features:</h3>
        <ul class="list-disc list-inside space-y-1 text-sm text-muted-foreground">
          <li>Multiple layout algorithms (force, hierarchical, radial, circular)</li>
          <li>Interactive node clustering</li>
          <li>Link strength visualization</li>
          <li>Drag and zoom controls</li>
          <li>Real-time network statistics</li>
        </ul>
      </div>
    </section>

    <!-- Treemap Chart -->
    <section class="space-y-4">
      <div>
        <h2 class="text-2xl font-semibold mb-2">Treemap Chart</h2>
        <p class="text-muted-foreground">
          Display hierarchical data as nested rectangles with drill-down navigation.
        </p>
      </div>
      <TreemapChart
        client:load
        data={treemapData}
        title="Content Hierarchy"
        enableDrilldown={true}
        showTooltip={true}
      />
      <div class="p-4 bg-muted rounded-lg">
        <h3 class="font-medium mb-2">Features:</h3>
        <ul class="list-disc list-inside space-y-1 text-sm text-muted-foreground">
          <li>Click to drill down into nested data</li>
          <li>Breadcrumb navigation</li>
          <li>Responsive rectangle sizing</li>
          <li>Hover details and tooltips</li>
          <li>Hierarchical statistics</li>
        </ul>
      </div>
    </section>

    <!-- Gantt Chart -->
    <section class="space-y-4">
      <div>
        <h2 class="text-2xl font-semibold mb-2">Gantt Chart</h2>
        <p class="text-muted-foreground">
          Plan and track project timelines with task dependencies and milestones.
        </p>
      </div>
      <GanttChart
        client:load
        tasks={ganttTasks}
        title="Project Timeline"
        showProgress={true}
        showDependencies={true}
        showMilestones={true}
        enableDrag={true}
      />
      <div class="p-4 bg-muted rounded-lg">
        <h3 class="font-medium mb-2">Features:</h3>
        <ul class="list-disc list-inside space-y-1 text-sm text-muted-foreground">
          <li>Task progress tracking</li>
          <li>Dependency visualization</li>
          <li>Milestone markers</li>
          <li>Drag to reschedule tasks</li>
          <li>Status indicators (pending, in-progress, completed, blocked)</li>
        </ul>
      </div>
    </section>

    <!-- Usage Example -->
    <section class="space-y-4">
      <h2 class="text-2xl font-semibold">Usage Example</h2>
      <div class="p-6 bg-muted rounded-lg">
        <pre class="text-sm overflow-x-auto"><code>{`import {
  HeatmapChart,
  NetworkDiagram,
  TreemapChart,
  GanttChart,
} from "@/components/ontology-ui/visualization";

// Heatmap
<HeatmapChart
  data={heatmapData}
  title="Activity Heatmap"
  exportable={true}
/>

// Network
<NetworkDiagram
  nodes={nodes}
  links={links}
  layoutType="force"
/>

// Treemap
<TreemapChart
  data={hierarchicalData}
  enableDrilldown={true}
/>

// Gantt
<GanttChart
  tasks={projectTasks}
  showProgress={true}
  showDependencies={true}
/>`}</code></pre>
      </div>
    </section>
  </div>
</Layout>
