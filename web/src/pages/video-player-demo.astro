---
/**
 * Video Player Demo Page
 * Showcases VideoPlayer component with progress tracking
 */

import Layout from '@/layouts/Layout.astro';
import { VideoPlayer } from '@/components/course/interactive/VideoPlayer';
---

<Layout title="Video Player Demo - ONE Platform" description="Custom HTML5 video player with progress tracking">
  <div class="min-h-screen">
    <!-- Header -->
    <header class="border-b border-border bg-card mb-8">
      <div class="container mx-auto px-4 py-6">
        <div class="flex items-center justify-between">
          <div>
            <h1 class="text-3xl font-bold">Video Player Demo</h1>
            <p class="text-muted-foreground mt-1">VideoPlayer component with progress tracking</p>
          </div>
          <a href="/demos" class="text-primary hover:underline">← Back to Demos</a>
        </div>
      </div>
    </header>

    <!-- Main Content -->
    <main id="main-content" class="container mx-auto px-4 pb-16">
        <div class="grid gap-8 lg:grid-cols-3">
          <!-- Video Player (larger column) -->
          <div class="lg:col-span-2 space-y-6">
            {/* Main Video */}
            <div>
              <h2 class="text-xl font-semibold mb-4">Lesson 1: Introduction to React</h2>
              <VideoPlayer
                client:load
                src="https://commondatastorage.googleapis.com/gtv-videos-bucket/sample/BigBuckBunny.mp4"
                poster="https://images.unsplash.com/photo-1633356122544-f134324a6cee?w=1200&h=675&fit=crop"
                title="Introduction to React"
                onProgress={(progress, currentTime) => {
                  console.log(`Progress: ${progress.toFixed(1)}% | Time: ${currentTime.toFixed(1)}s`);
                }}
                onComplete={() => {
                  console.log('Video completed!');
                  alert('🎉 Lesson completed! Great job!');
                }}
                className="aspect-video"
              />
            </div>

            {/* Features List */}
            <div class="bg-card border border-border rounded-lg p-6">
              <h3 class="text-lg font-semibold mb-4">Features</h3>
              <div class="grid sm:grid-cols-2 gap-4 text-sm">
                <div class="flex items-start gap-2">
                  <span class="text-green-500">✓</span>
                  <div>
                    <div class="font-medium">Custom Controls</div>
                    <div class="text-muted-foreground">Play, pause, skip, volume</div>
                  </div>
                </div>
                <div class="flex items-start gap-2">
                  <span class="text-green-500">✓</span>
                  <div>
                    <div class="font-medium">Playback Speed</div>
                    <div class="text-muted-foreground">0.25x to 2x speed</div>
                  </div>
                </div>
                <div class="flex items-start gap-2">
                  <span class="text-green-500">✓</span>
                  <div>
                    <div class="font-medium">Progress Tracking</div>
                    <div class="text-muted-foreground">Real-time progress callbacks</div>
                  </div>
                </div>
                <div class="flex items-start gap-2">
                  <span class="text-green-500">✓</span>
                  <div>
                    <div class="font-medium">Keyboard Shortcuts</div>
                    <div class="text-muted-foreground">Space, arrows, F, M, 0-9</div>
                  </div>
                </div>
                <div class="flex items-start gap-2">
                  <span class="text-green-500">✓</span>
                  <div>
                    <div class="font-medium">Fullscreen Mode</div>
                    <div class="text-muted-foreground">Immersive viewing</div>
                  </div>
                </div>
                <div class="flex items-start gap-2">
                  <span class="text-green-500">✓</span>
                  <div>
                    <div class="font-medium">Auto-hide Controls</div>
                    <div class="text-muted-foreground">Clean viewing experience</div>
                  </div>
                </div>
                <div class="flex items-start gap-2">
                  <span class="text-green-500">✓</span>
                  <div>
                    <div class="font-medium">Buffering Indicator</div>
                    <div class="text-muted-foreground">Shows loaded content</div>
                  </div>
                </div>
                <div class="flex items-start gap-2">
                  <span class="text-green-500">✓</span>
                  <div>
                    <div class="font-medium">Completion Callback</div>
                    <div class="text-muted-foreground">Track lesson completion</div>
                  </div>
                </div>
              </div>
            </div>

            {/* Keyboard Shortcuts Reference */}
            <div class="bg-card border border-border rounded-lg p-6">
              <h3 class="text-lg font-semibold mb-4">Keyboard Shortcuts</h3>
              <div class="grid sm:grid-cols-2 gap-3 text-sm">
                <div class="flex items-center justify-between">
                  <span class="text-muted-foreground">Play / Pause</span>
                  <kbd class="px-2 py-1 bg-muted rounded text-xs font-mono">Space</kbd>
                </div>
                <div class="flex items-center justify-between">
                  <span class="text-muted-foreground">Play / Pause</span>
                  <kbd class="px-2 py-1 bg-muted rounded text-xs font-mono">K</kbd>
                </div>
                <div class="flex items-center justify-between">
                  <span class="text-muted-foreground">Skip Backward 5s</span>
                  <kbd class="px-2 py-1 bg-muted rounded text-xs font-mono">←</kbd>
                </div>
                <div class="flex items-center justify-between">
                  <span class="text-muted-foreground">Skip Forward 5s</span>
                  <kbd class="px-2 py-1 bg-muted rounded text-xs font-mono">→</kbd>
                </div>
                <div class="flex items-center justify-between">
                  <span class="text-muted-foreground">Volume Up</span>
                  <kbd class="px-2 py-1 bg-muted rounded text-xs font-mono">↑</kbd>
                </div>
                <div class="flex items-center justify-between">
                  <span class="text-muted-foreground">Volume Down</span>
                  <kbd class="px-2 py-1 bg-muted rounded text-xs font-mono">↓</kbd>
                </div>
                <div class="flex items-center justify-between">
                  <span class="text-muted-foreground">Fullscreen</span>
                  <kbd class="px-2 py-1 bg-muted rounded text-xs font-mono">F</kbd>
                </div>
                <div class="flex items-center justify-between">
                  <span class="text-muted-foreground">Mute / Unmute</span>
                  <kbd class="px-2 py-1 bg-muted rounded text-xs font-mono">M</kbd>
                </div>
                <div class="flex items-center justify-between col-span-2">
                  <span class="text-muted-foreground">Jump to % (e.g., 5 = 50%)</span>
                  <kbd class="px-2 py-1 bg-muted rounded text-xs font-mono">0-9</kbd>
                </div>
              </div>
            </div>
          </div>

          <!-- Sidebar (smaller column) -->
          <div class="space-y-6">
            {/* Course Info */}
            <div class="bg-card border border-border rounded-lg p-6">
              <h3 class="text-lg font-semibold mb-4">Course Progress</h3>
              <div class="space-y-4">
                <div>
                  <div class="flex items-center justify-between text-sm mb-2">
                    <span>Overall Progress</span>
                    <span class="font-semibold">12%</span>
                  </div>
                  <div class="h-2 bg-muted rounded-full overflow-hidden">
                    <div class="h-full bg-primary" style="width: 12%"></div>
                  </div>
                </div>
                <div class="text-sm text-muted-foreground">
                  <div>✓ Introduction completed</div>
                  <div class="ml-4 mt-1">• Currently watching</div>
                  <div class="ml-4 mt-1 opacity-50">• Next: React Components</div>
                </div>
              </div>
            </div>

            {/* Additional Videos */}
            <div class="bg-card border border-border rounded-lg p-6">
              <h3 class="text-lg font-semibold mb-4">Next Lessons</h3>
              <div class="space-y-3">
                <div class="flex gap-3 p-2 hover:bg-muted rounded-lg cursor-pointer transition-colors">
                  <div class="w-24 h-16 bg-muted rounded flex-shrink-0 flex items-center justify-center">
                    <span class="text-2xl">▶️</span>
                  </div>
                  <div class="flex-1 min-w-0">
                    <div class="font-medium text-sm truncate">Lesson 2: Components</div>
                    <div class="text-xs text-muted-foreground">12:34</div>
                  </div>
                </div>
                <div class="flex gap-3 p-2 hover:bg-muted rounded-lg cursor-pointer transition-colors">
                  <div class="w-24 h-16 bg-muted rounded flex-shrink-0 flex items-center justify-center">
                    <span class="text-2xl">▶️</span>
                  </div>
                  <div class="flex-1 min-w-0">
                    <div class="font-medium text-sm truncate">Lesson 3: Props & State</div>
                    <div class="text-xs text-muted-foreground">18:22</div>
                  </div>
                </div>
                <div class="flex gap-3 p-2 hover:bg-muted rounded-lg cursor-pointer transition-colors">
                  <div class="w-24 h-16 bg-muted rounded flex-shrink-0 flex items-center justify-center">
                    <span class="text-2xl">▶️</span>
                  </div>
                  <div class="flex-1 min-w-0">
                    <div class="font-medium text-sm truncate">Lesson 4: Hooks</div>
                    <div class="text-xs text-muted-foreground">24:15</div>
                  </div>
                </div>
              </div>
            </div>

            {/* Resources */}
            <div class="bg-card border border-border rounded-lg p-6">
              <h3 class="text-lg font-semibold mb-4">Lesson Resources</h3>
              <div class="space-y-2 text-sm">
                <a href="#" class="flex items-center gap-2 text-primary hover:underline">
                  <span>📄</span>
                  <span>Lesson Slides (PDF)</span>
                </a>
                <a href="#" class="flex items-center gap-2 text-primary hover:underline">
                  <span>💻</span>
                  <span>Code Examples</span>
                </a>
                <a href="#" class="flex items-center gap-2 text-primary hover:underline">
                  <span>📝</span>
                  <span>Practice Exercises</span>
                </a>
              </div>
            </div>
          </div>
        </div>
      </main>

      <!-- Footer -->
      <footer class="border-t border-border bg-card mt-16">
        <div class="container mx-auto px-4 py-8 text-center text-muted-foreground">
          <p>🎥 Video Player Demo - Built with ONE Platform</p>
          <p class="text-sm mt-2">
            Components: VideoPlayer, useVideoPlayer hook
          </p>
        </div>
      </footer>
    </div>
</Layout>
