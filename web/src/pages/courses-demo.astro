---

<Layout title="Course Catalog Demo - ONE Platform" description="Browse and filter courses with advanced search capabilities">
  <div class="min-h-screen">
    <!-- Header -->
    <header class="border-b border-border bg-card mb-8">
      <div class="container mx-auto px-4 py-6">
        <div class="flex items-center justify-between">
          <div>
            <h1 class="text-3xl font-bold">Course Catalog Demo</h1>
            <p class="text-muted-foreground mt-1">
              CourseCard, CourseGrid, CourseFilters
            </p>
          </div>
          <a href="/demos" class="text-primary hover:underline">← Back to Demos</a>
        </div>
      </div>
    </header>

    <!-- Main Content -->
    <main id="main-content" class="container mx-auto px-4 pb-16">
      <div class="flex gap-8">
        <!-- Filters Sidebar (Desktop) -->
        <aside class="hidden lg:block flex-shrink-0">
          <CourseFilters
            client:load
            categories={categories}
            onFilterChange={(filters) => {
              console.log('Filters changed:', filters);
            }}
          />
        </aside>

        <!-- Course Grid -->
        <div class="flex-1">
          <!-- Mobile Filters -->
          <div class="lg:hidden mb-6">
            <CourseFilters
              client:load
              categories={categories}
              isMobile={true}
              onFilterChange={(filters) => {
                console.log('Filters changed:', filters);
              }}
            />
          </div>

          <!-- Results Header -->
          <div class="flex items-center justify-between mb-6">
            <h2 class="text-xl font-semibold">
              {mockCourses.length} Courses Available
            </h2>
          </div>

          <!-- Course Grid -->
          <CourseGrid courses={mockCourses}>
            {mockCourses.map((course) => (
              <CourseCard client:load course={course} />
            ))}
          </CourseGrid>
        </div>
      </div>
    </main>
  </div>
</Layout>
