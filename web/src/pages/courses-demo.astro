---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Course Catalog Demo - ONE Platform</title>
  </head>
  <body>
    <div class="min-h-screen bg-background">
      <!-- Header -->
      <header class="border-b border-border bg-card">
        <div class="container mx-auto px-4 py-4">
          <h1 class="text-2xl font-bold text-foreground">Course Catalog Demo</h1>
          <p class="text-muted-foreground mt-1">
            Showcasing CourseCard, CourseGrid, and CourseFilters components
          </p>
        </div>
      </header>

      <!-- Main Content -->
      <main class="container mx-auto px-4 py-8">
        <div class="flex gap-8">
          <!-- Filters Sidebar (Desktop) -->
          <aside class="hidden lg:block flex-shrink-0">
            <CourseFilters
              client:load
              categories={categories}
              onFilterChange={(filters) => {
                console.log('Filters changed:', filters);
              }}
            />
          </aside>

          <!-- Course Grid -->
          <div class="flex-1">
            <!-- Mobile Filters -->
            <div class="lg:hidden mb-6">
              <CourseFilters
                client:load
                categories={categories}
                isMobile={true}
                onFilterChange={(filters) => {
                  console.log('Filters changed:', filters);
                }}
              />
            </div>

            <!-- Results Header -->
            <div class="flex items-center justify-between mb-6">
              <h2 class="text-xl font-semibold text-foreground">
                {mockCourses.length} Courses Available
              </h2>
            </div>

            <!-- Course Grid -->
            <CourseGrid courses={mockCourses}>
              {mockCourses.map((course) => (
                <CourseCard client:load course={course} />
              ))}
            </CourseGrid>
          </div>
        </div>
      </main>

      <!-- Footer -->
      <footer class="border-t border-border bg-card mt-16">
        <div class="container mx-auto px-4 py-8 text-center text-muted-foreground">
          <p>🎓 Course Catalog Demo - Built with ONE Platform</p>
          <p class="text-sm mt-2">
            Components: CourseCard, CourseGrid, CourseFilters
          </p>
        </div>
      </footer>
    </div>
  </body>
</html>
