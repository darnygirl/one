# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# ONE E-Commerce Package - Environment Configuration
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

# ┌─────────────────────────────────────────────────────────────────┐
# │ STRIPE CONFIGURATION (Card Payments)                             │
# └─────────────────────────────────────────────────────────────────┘

# Get your keys: https://dashboard.stripe.com/apikeys

# Secret Key (Server-side only, never expose in client code)
STRIPE_SECRET_KEY=sk_test_YOUR_SECRET_KEY_HERE

# Publishable Key (Safe to expose in client code)
PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_YOUR_PUBLISHABLE_KEY_HERE

# ┌─────────────────────────────────────────────────────────────────┐
# │ X402 CONFIGURATION (Crypto Payments - Optional)                  │
# └─────────────────────────────────────────────────────────────────┘

# Enable/disable X402 crypto payments
PUBLIC_X402_ENABLED=true

# Get your WalletConnect Project ID: https://cloud.walletconnect.com/
PUBLIC_WALLETCONNECT_PROJECT_ID=your_walletconnect_project_id_here

# Your wallet address to receive USDC payments
PUBLIC_X402_RECIPIENT_ADDRESS=0x742d35Cc6634C0532925a3b844Bc454e4438f44e

# ┌─────────────────────────────────────────────────────────────────┐
# │ NETWORK CONFIGURATION (Optional - defaults to Base mainnet)      │
# └─────────────────────────────────────────────────────────────────┘

# Uncomment to use testnet for development
# PUBLIC_USE_TESTNET=true

# ┌─────────────────────────────────────────────────────────────────┐
# │ APPLICATION CONFIGURATION (Optional)                              │
# └─────────────────────────────────────────────────────────────────┘

# Base URL for your application (used in Stripe redirects)
PUBLIC_BASE_URL=http://localhost:4321

# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# QUICK SETUP GUIDE
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

# 1. STRIPE SETUP (5 minutes)
#    - Create account: https://dashboard.stripe.com/register
#    - Get test keys: https://dashboard.stripe.com/apikeys
#    - Paste keys above
#    - Test with card: 4242 4242 4242 4242

# 2. X402 SETUP (Optional, 10 minutes)
#    - Create WalletConnect project: https://cloud.walletconnect.com/
#    - Get Project ID and paste above
#    - Add your wallet address for receiving USDC
#    - Test on Base Sepolia testnet first

# 3. PRODUCTION CHECKLIST
#    - [ ] Replace test keys with live Stripe keys
#    - [ ] Update recipient address to treasury wallet
#    - [ ] Update PUBLIC_BASE_URL to your domain
#    - [ ] Set PUBLIC_USE_TESTNET=false
#    - [ ] Test complete checkout flow
#    - [ ] Set up Stripe webhooks (optional)

# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# PAYMENT METHODS COMPARISON
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

# STRIPE (Cards)
# ✅ Accepts all major cards
# ✅ Familiar checkout flow
# ✅ Fraud protection included
# ⚠️  2.9% + $0.30 per transaction
# ⚠️  2-3 day settlement

# X402 (Crypto)
# ✅ Ultra-low fees (~$0.0001)
# ✅ Instant settlement (2-5 seconds)
# ✅ No chargebacks
# ⚠️  Requires crypto wallet
# ⚠️  Less familiar to mainstream users

# RECOMMENDATION:
# - Offer both for maximum flexibility
# - Most users will choose Stripe
# - Crypto-savvy users will appreciate X402
# - You save on fees with crypto payments

# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# TESTING
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

# Stripe Test Cards:
# Success: 4242 4242 4242 4242 (any future date, any CVC, any ZIP)
# 3D Secure: 4000 0025 0000 3155
# Declined: 4000 0000 0000 9995

# X402 Testing:
# - Use Base Sepolia testnet
# - Get testnet ETH: https://www.coinbase.com/faucets
# - Swap for testnet USDC
# - Test payment flow

# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
