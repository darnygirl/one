---
/**
 * Order Confirmation Page - ONE Platform E-Commerce
 * Beautiful order confirmation with download/access links
 * Based on product-landing.astro design principles
 *
 * Features:
 * - Order number and details
 * - Payment confirmation
 * - Digital product access links
 * - Download invoice
 * - Track order button
 * - Email receipt confirmation
 * - Dark mode support
 */

import ShopLayout from '@/layouts/ShopLayout.astro';
import { ProductHeader } from '@/components/shop/ProductHeader';
import { ThemeToggle } from '@/components/shop/ThemeToggle';

// Check if Stripe is configured
const stripeSecretKey = import.meta.env.STRIPE_SECRET_KEY;
const stripeEnabled = Boolean(stripeSecretKey);

// Get session ID or order ID from URL params
const sessionId = Astro.url.searchParams.get('session_id');
const orderNumber = Astro.url.searchParams.get('order') || `ORD-${Date.now()}`;
const txHash = Astro.url.searchParams.get('tx'); // For X402 payments

// Initialize Stripe if enabled
let stripe: any = null;
if (stripeEnabled) {
  const { default: Stripe } = await import('stripe');
  stripe = new Stripe(stripeSecretKey);
}

// Retrieve Stripe session if session_id is provided
let stripeSession: any = null;
if (stripeEnabled && sessionId) {
  try {
    stripeSession = await stripe.checkout.sessions.retrieve(sessionId, {
      expand: ['line_items', 'payment_intent'],
    });
  } catch (error) {
    console.error('Error retrieving Stripe session:', error);
  }
}

// Build order data from Stripe session or use mock data
let order: any;

if (stripeSession) {
  // Extract order data from Stripe session
  const lineItems = stripeSession.line_items?.data || [];

  order = {
    orderNumber: sessionId.slice(-12).toUpperCase(),
    status: 'completed',
    createdAt: new Date(stripeSession.created * 1000),
    customerName: stripeSession.customer_details?.name || 'Customer',
    customerEmail: stripeSession.customer_details?.email || '',
    items: lineItems.map((item: any) => ({
      id: item.price.product,
      name: item.description,
      price: item.price.unit_amount / 100,
      quantity: item.quantity,
      image: 'https://i.imgur.com/Y54Bt8J.jpeg', // TODO: Get from product data
      downloadUrl: null,
    })),
    subtotal: stripeSession.amount_subtotal / 100,
    tax: (stripeSession.total_details?.amount_tax || 0) / 100,
    shipping: (stripeSession.total_details?.amount_shipping || 0) / 100,
    total: stripeSession.amount_total / 100,
    paymentMethod: 'Credit Card (Stripe)',
    shippingAddress: stripeSession.shipping_details ? {
      name: stripeSession.shipping_details.name,
      address: stripeSession.shipping_details.address.line1 + (stripeSession.shipping_details.address.line2 ? `, ${stripeSession.shipping_details.address.line2}` : ''),
      city: stripeSession.shipping_details.address.city,
      state: stripeSession.shipping_details.address.state,
      zip: stripeSession.shipping_details.address.postal_code,
      country: stripeSession.shipping_details.address.country,
    } : null,
  };
} else if (txHash) {
  // X402 crypto payment
  order = {
    orderNumber,
    status: 'completed',
    createdAt: new Date(),
    customerName: 'Crypto Customer',
    customerEmail: 'customer@example.com',
    items: [
      {
        id: '1',
        name: 'Digital Product',
        price: 145.00,
        quantity: 1,
        image: 'https://i.imgur.com/Y54Bt8J.jpeg',
        downloadUrl: null,
      }
    ],
    subtotal: 145.00,
    tax: 0,
    shipping: 0,
    total: 145.00,
    paymentMethod: 'USDC (X402 Protocol)',
    transactionHash: txHash,
    shippingAddress: null,
  };
} else {
  // Mock order data (fallback)
  order = {
    orderNumber,
    status: 'completed',
    createdAt: new Date(),
    customerName: 'John Doe',
    customerEmail: 'john@example.com',
    items: [
      {
        id: '1',
        name: 'Classic White Tee',
        price: 73,
        quantity: 2,
        image: 'https://i.imgur.com/Y54Bt8J.jpeg',
        downloadUrl: '/downloads/product-1',
      },
      {
        id: '2',
        name: 'Sleek Modern Laptop',
        price: 1299,
        quantity: 1,
        image: 'https://i.imgur.com/QkIa5tT.jpeg',
        downloadUrl: null,
      }
    ],
    subtotal: 1445,
    tax: 0,
    shipping: 0,
    total: 1445,
    paymentMethod: 'Mock Payment',
    shippingAddress: {
      name: 'John Doe',
      address: '123 Main St, Apt 4B',
      city: 'San Francisco',
      state: 'CA',
      zip: '94102',
      country: 'United States',
    }
  };
}
---

<ShopLayout title={`Order ${orderNumber} Confirmed`} description="Thank you for your order">
  <div class="bg-white dark:bg-black text-black dark:text-white min-h-screen">

    <!-- Header -->
    <ProductHeader client:load productName="Order Confirmed" />

    <!-- Success Hero -->
    <section class="max-w-4xl mx-auto px-6 py-16 text-center border-b border-black dark:border-white">
      <!-- Success Icon -->
      <div class="mb-8">
        <div class="inline-flex items-center justify-center w-20 h-20 border-4 border-black dark:border-white rounded-full">
          <svg class="w-10 h-10" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="3" d="M5 13l4 4L19 7" />
          </svg>
        </div>
      </div>

      <h1 class="text-5xl md:text-6xl font-light tracking-tight mb-4">
        Order Confirmed
      </h1>

      <p class="text-base opacity-80 mb-8 max-w-2xl mx-auto">
        Thank you for your purchase! Your order has been confirmed and will be processed shortly.
        A confirmation email has been sent to <strong>{order.customerEmail}</strong>
      </p>

      <!-- Order Number -->
      <div class="inline-block border-2 border-black dark:border-white px-8 py-4 mb-8">
        <p class="text-xs font-bold tracking-[0.2em] uppercase opacity-60 mb-1">Order Number</p>
        <p class="text-2xl font-light tracking-tight tabular-nums">{order.orderNumber}</p>
      </div>

      <!-- Quick Actions -->
      <div class="flex flex-col sm:flex-row gap-4 justify-center">
        <a
          href={`/shop/orders/${order.orderNumber}`}
          class="px-8 py-4 bg-black dark:bg-white text-white dark:text-black border-2 border-black dark:border-white hover:opacity-80 transition-opacity"
        >
          <span class="text-xs font-bold tracking-[0.2em] uppercase">Track Order</span>
        </a>
        <a
          href="/shop/marketplace"
          class="px-8 py-4 border-2 border-black dark:border-white hover:bg-black dark:hover:bg-white hover:text-white dark:hover:text-black transition-colors"
        >
          <span class="text-xs font-bold tracking-[0.2em] uppercase">Continue Shopping</span>
        </a>
      </div>
    </section>

    <!-- Order Details -->
    <section class="max-w-6xl mx-auto px-6 py-16">
      <div class="grid lg:grid-cols-3 gap-12">

        <!-- Left: Order Items -->
        <div class="lg:col-span-2 space-y-8">

          <!-- Items List -->
          <div>
            <h2 class="text-2xl font-light tracking-tight mb-6 pb-4 border-b-2 border-black dark:border-white">
              Order Items
            </h2>

            <div class="space-y-4">
              {order.items.map(item => (
                <div class="flex gap-4 border-2 border-black dark:border-white p-4">
                  <img
                    src={item.image}
                    alt={item.name}
                    class="w-24 h-24 object-cover border border-black dark:border-white"
                  />
                  <div class="flex-1">
                    <h3 class="text-base font-medium mb-1">{item.name}</h3>
                    <p class="text-sm opacity-60 mb-2">Quantity: {item.quantity}</p>
                    <p class="text-sm font-bold">${(item.price * item.quantity).toFixed(2)}</p>

                    {item.downloadUrl && (
                      <a
                        href={item.downloadUrl}
                        class="inline-flex items-center gap-2 mt-3 text-xs font-bold tracking-[0.2em] uppercase hover:opacity-60 transition-opacity"
                      >
                        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4" />
                        </svg>
                        <span>Download</span>
                      </a>
                    )}
                  </div>
                </div>
              ))}
            </div>
          </div>

          <!-- Shipping Address -->
          {order.shippingAddress && (
            <div>
              <h2 class="text-2xl font-light tracking-tight mb-6 pb-4 border-b-2 border-black dark:border-white">
                Shipping Address
              </h2>

              <div class="border-2 border-black dark:border-white p-6">
                <p class="font-medium mb-1">{order.shippingAddress.name}</p>
                <p class="text-sm opacity-80">{order.shippingAddress.address}</p>
                <p class="text-sm opacity-80">
                  {order.shippingAddress.city}, {order.shippingAddress.state} {order.shippingAddress.zip}
                </p>
                <p class="text-sm opacity-80">{order.shippingAddress.country}</p>
              </div>
            </div>
          )}

          <!-- What's Next? -->
          <div>
            <h2 class="text-2xl font-light tracking-tight mb-6 pb-4 border-b-2 border-black dark:border-white">
              What Happens Next?
            </h2>

            <div class="space-y-6">
              <div class="flex gap-4">
                <div class="flex-shrink-0 w-10 h-10 border-2 border-black dark:border-white flex items-center justify-center">
                  <span class="text-sm font-bold">1</span>
                </div>
                <div>
                  <h3 class="text-sm font-bold tracking-[0.2em] uppercase mb-2">Order Confirmation</h3>
                  <p class="text-sm opacity-80">You'll receive an email confirmation with your order details.</p>
                </div>
              </div>

              <div class="flex gap-4">
                <div class="flex-shrink-0 w-10 h-10 border-2 border-black dark:border-white flex items-center justify-center">
                  <span class="text-sm font-bold">2</span>
                </div>
                <div>
                  <h3 class="text-sm font-bold tracking-[0.2em] uppercase mb-2">Order Processing</h3>
                  <p class="text-sm opacity-80">Your order is being prepared and will ship within 24-48 hours.</p>
                </div>
              </div>

              <div class="flex gap-4">
                <div class="flex-shrink-0 w-10 h-10 border-2 border-black dark:border-white flex items-center justify-center">
                  <span class="text-sm font-bold">3</span>
                </div>
                <div>
                  <h3 class="text-sm font-bold tracking-[0.2em] uppercase mb-2">Shipping Updates</h3>
                  <p class="text-sm opacity-80">You'll receive a tracking number once your order ships.</p>
                </div>
              </div>

              <div class="flex gap-4">
                <div class="flex-shrink-0 w-10 h-10 border-2 border-black dark:border-white flex items-center justify-center">
                  <span class="text-sm font-bold">4</span>
                </div>
                <div>
                  <h3 class="text-sm font-bold tracking-[0.2em] uppercase mb-2">Delivery</h3>
                  <p class="text-sm opacity-80">Estimated delivery: 3-5 business days.</p>
                </div>
              </div>
            </div>
          </div>
        </div>

        <!-- Right: Order Summary (Sticky) -->
        <div class="lg:col-span-1">
          <div class="border-2 border-black dark:border-white p-6 sticky top-6 space-y-6">
            <h3 class="text-sm font-bold tracking-[0.2em] uppercase border-b-2 border-black dark:border-white pb-4">
              Order Summary
            </h3>

            <div class="space-y-3">
              <div class="flex justify-between text-sm">
                <span class="opacity-60">Subtotal</span>
                <span class="font-medium tabular-nums">${order.subtotal.toFixed(2)}</span>
              </div>
              <div class="flex justify-between text-sm">
                <span class="opacity-60">Shipping</span>
                <span class="font-bold tracking-wide">FREE</span>
              </div>
              <div class="flex justify-between text-sm">
                <span class="opacity-60">Tax</span>
                <span class="tabular-nums">${order.tax.toFixed(2)}</span>
              </div>
              <div class="flex justify-between pt-4 border-t-2 border-black dark:border-white">
                <span class="text-sm font-bold tracking-[0.2em] uppercase">Total</span>
                <span class="text-2xl font-light tabular-nums">${order.total.toFixed(2)}</span>
              </div>
            </div>

            <div class="border-t-2 border-black dark:border-white pt-4 space-y-2">
              <p class="text-xs opacity-60">Payment Method</p>
              <p class="text-sm font-medium">{order.paymentMethod}</p>
              {order.transactionHash && (
                <div class="mt-2 pt-2 border-t border-black/20 dark:border-white/20">
                  <p class="text-xs opacity-60 mb-1">Transaction Hash</p>
                  <a
                    href={`https://basescan.org/tx/${order.transactionHash}`}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="text-xs font-mono hover:opacity-60 transition-opacity flex items-center gap-1"
                  >
                    {order.transactionHash.slice(0, 10)}...{order.transactionHash.slice(-8)}
                    <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
                    </svg>
                  </a>
                </div>
              )}
            </div>

            <div class="border-t-2 border-black dark:border-white pt-4 space-y-2">
              <p class="text-xs opacity-60">Order Date</p>
              <p class="text-sm font-medium">
                {order.createdAt.toLocaleDateString('en-US', {
                  month: 'long',
                  day: 'numeric',
                  year: 'numeric'
                })}
              </p>
            </div>

            <!-- Download Invoice -->
            <button
              onclick="downloadInvoice()"
              class="w-full px-6 py-4 border-2 border-black dark:border-white hover:bg-black dark:hover:bg-white hover:text-white dark:hover:text-black transition-colors"
            >
              <div class="flex items-center justify-center gap-2">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4" />
                </svg>
                <span class="text-xs font-bold tracking-[0.2em] uppercase">Download Invoice</span>
              </div>
            </button>

            <!-- Need Help? -->
            <div class="border-t-2 border-black dark:border-white pt-4">
              <p class="text-xs opacity-60 mb-3">Need help with your order?</p>
              <a
                href="/contact"
                class="inline-flex items-center gap-2 text-xs font-bold tracking-[0.2em] uppercase hover:opacity-60 transition-opacity"
              >
                <span>Contact Support</span>
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7l5 5m0 0l-5 5m5-5H6" />
                </svg>
              </a>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Social Share / Recommendations -->
    <section class="max-w-4xl mx-auto px-6 py-16 text-center border-t border-black dark:border-white">
      <h2 class="text-3xl font-light tracking-tight mb-4">
        Share Your Purchase
      </h2>
      <p class="text-base opacity-80 mb-8">
        Share your excitement with friends and family
      </p>

      <div class="flex gap-4 justify-center">
        <button class="p-3 border-2 border-black dark:border-white hover:bg-black dark:hover:bg-white hover:text-white dark:hover:text-black transition-colors">
          <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
            <path d="M24 4.557c-.883.392-1.832.656-2.828.775 1.017-.609 1.798-1.574 2.165-2.724-.951.564-2.005.974-3.127 1.195-.897-.957-2.178-1.555-3.594-1.555-3.179 0-5.515 2.966-4.797 6.045-4.091-.205-7.719-2.165-10.148-5.144-1.29 2.213-.669 5.108 1.523 6.574-.806-.026-1.566-.247-2.229-.616-.054 2.281 1.581 4.415 3.949 4.89-.693.188-1.452.232-2.224.084.626 1.956 2.444 3.379 4.6 3.419-2.07 1.623-4.678 2.348-7.29 2.04 2.179 1.397 4.768 2.212 7.548 2.212 9.142 0 14.307-7.721 13.995-14.646.962-.695 1.797-1.562 2.457-2.549z"/>
          </svg>
        </button>
        <button class="p-3 border-2 border-black dark:border-white hover:bg-black dark:hover:bg-white hover:text-white dark:hover:text-black transition-colors">
          <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
            <path d="M9 8h-3v4h3v12h5v-12h3.642l.358-4h-4v-1.667c0-.955.192-1.333 1.115-1.333h2.885v-5h-3.808c-3.596 0-5.192 1.583-5.192 4.615v3.385z"/>
          </svg>
        </button>
        <button class="p-3 border-2 border-black dark:border-white hover:bg-black dark:hover:bg-white hover:text-white dark:hover:text-black transition-colors">
          <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
            <path d="M4.98 3.5c0 1.381-1.11 2.5-2.48 2.5s-2.48-1.119-2.48-2.5c0-1.38 1.11-2.5 2.48-2.5s2.48 1.12 2.48 2.5zm.02 4.5h-5v16h5v-16zm7.982 0h-4.968v16h4.969v-8.399c0-4.67 6.029-5.052 6.029 0v8.399h4.988v-10.131c0-7.88-8.922-7.593-11.018-3.714v-2.155z"/>
          </svg>
        </button>
      </div>
    </section>

    <!-- Theme Toggle -->
    <ThemeToggle client:load />
  </div>

  <script>
    function downloadInvoice() {
      // TODO: Generate and download PDF invoice
      alert('Invoice download would be implemented here');
    }

    // Expose globally
    (window as any).downloadInvoice = downloadInvoice;
  </script>
</ShopLayout>
