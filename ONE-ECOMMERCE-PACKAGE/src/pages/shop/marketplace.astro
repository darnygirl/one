---
/**
 * Enhanced Shop Marketplace - ONE Platform E-Commerce
 * Beautiful product listing with filters, search, and sorting
 * Based on product-landing.astro design principles
 *
 * Features:
 * - Product grid with beautiful cards
 * - Category filters
 * - Price range slider
 * - Search functionality
 * - Sorting options
 * - Dark mode support
 * - Responsive design
 */

import ShopLayout from '@/layouts/ShopLayout.astro';
import { getCollection } from 'astro:content';
import { ProductHeader } from '@/components/shop/ProductHeader';
import ProductCard from '@/components/ecommerce/interactive/ProductCard';
import { ThemeToggle } from '@/components/shop/ThemeToggle';
import { FilterSidebar } from '@/components/ecommerce/interactive/FilterSidebar';

// Get all products from content collection
const allProducts = await getCollection('products');

// Transform products for display
const products = allProducts.map(p => ({
  id: p.id,
  slug: p.slug,
  name: p.data.name,
  description: p.data.description,
  price: p.data.price,
  compareAtPrice: p.data.compareAtPrice,
  salePrice: p.data.salePrice,
  images: p.data.images,
  thumbnail: p.data.images[0],
  category: p.data.category,
  tags: p.data.tags || [],
  inStock: p.data.inStock,
  featured: p.data.featured,
  isSale: p.data.isSale,
  isNew: p.data.isNew,
  rating: 4.5 + Math.random() * 0.5,
  reviewCount: Math.floor(Math.random() * 100) + 20,
  createdAt: new Date(),
  updatedAt: new Date(),
}));

// Get all categories
const allCategories = await getCollection('categories');
const categories = allCategories.map(cat => ({
  slug: cat.slug,
  name: cat.data.name || cat.slug.charAt(0).toUpperCase() + cat.slug.slice(1),
  description: cat.data.description,
  image: cat.data.image,
}));

// Get unique price range
const prices = products.map(p => p.price);
const minPrice = Math.min(...prices);
const maxPrice = Math.max(...prices);

// Get total count
const totalProducts = products.length;
---

<ShopLayout title="Shop Marketplace - ONE Platform" description="Discover premium products for every lifestyle">
  <div class="bg-white dark:bg-black text-black dark:text-white min-h-screen">

    <!-- Header -->
    <ProductHeader client:load productName="Marketplace" />

    <!-- Hero Section -->
    <section class="max-w-7xl mx-auto px-6 py-16 border-b border-black dark:border-white">
      <div class="text-center space-y-6">
        <p class="text-xs font-bold tracking-[0.3em] uppercase">
          Premium Collection
        </p>
        <h1 class="text-5xl md:text-6xl font-light tracking-tight leading-none">
          Shop Marketplace
        </h1>
        <p class="text-base leading-relaxed max-w-2xl mx-auto opacity-80">
          Discover thoughtfully designed products crafted with premium materials and exceptional attention to detail.
        </p>
        <div class="flex items-center justify-center gap-8 pt-4">
          <div class="text-center">
            <div class="text-2xl font-light tabular-nums">{totalProducts}</div>
            <div class="text-xs tracking-wide opacity-60">Products</div>
          </div>
          <div class="h-8 w-px bg-black dark:bg-white opacity-20"></div>
          <div class="text-center">
            <div class="text-2xl font-light tabular-nums">{categories.length}</div>
            <div class="text-xs tracking-wide opacity-60">Categories</div>
          </div>
          <div class="h-8 w-px bg-black dark:bg-white opacity-20"></div>
          <div class="text-center">
            <div class="text-2xl font-light tabular-nums">4.8★</div>
            <div class="text-xs tracking-wide opacity-60">Avg Rating</div>
          </div>
        </div>
      </div>
    </section>

    <!-- Category Pills -->
    <section class="max-w-7xl mx-auto px-6 py-8 border-b border-black dark:border-white">
      <div class="flex flex-wrap gap-3 justify-center">
        <button
          data-category="all"
          class="category-pill px-6 py-2 border-2 border-black dark:border-white hover:bg-black dark:hover:bg-white hover:text-white dark:hover:text-black transition-colors duration-200 active"
        >
          <span class="text-xs font-bold tracking-[0.2em] uppercase">All</span>
        </button>
        {categories.map(cat => (
          <button
            data-category={cat.slug}
            class="category-pill px-6 py-2 border-2 border-black dark:border-white hover:bg-black dark:hover:bg-white hover:text-white dark:hover:text-black transition-colors duration-200"
          >
            <span class="text-xs font-bold tracking-[0.2em] uppercase">{cat.name}</span>
          </button>
        ))}
      </div>
    </section>

    <!-- Filters & Sorting Bar -->
    <section class="max-w-7xl mx-auto px-6 py-6 border-b border-black dark:border-white">
      <div class="flex flex-col md:flex-row gap-4 justify-between items-start md:items-center">

        <!-- Search -->
        <div class="flex-1 max-w-md">
          <div class="relative">
            <input
              type="text"
              id="product-search"
              placeholder="Search products..."
              class="w-full px-4 py-3 border-2 border-black dark:border-white bg-transparent focus:outline-none focus:ring-2 focus:ring-black dark:focus:ring-white"
            />
            <svg class="absolute right-4 top-1/2 -translate-y-1/2 w-5 h-5 opacity-60" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
            </svg>
          </div>
        </div>

        <!-- Sort Dropdown -->
        <div class="flex items-center gap-4">
          <label class="text-xs font-bold tracking-[0.2em] uppercase whitespace-nowrap">Sort By</label>
          <select
            id="sort-select"
            class="px-4 py-3 border-2 border-black dark:border-white bg-transparent focus:outline-none focus:ring-2 focus:ring-black dark:focus:ring-white text-sm"
          >
            <option value="featured">Featured</option>
            <option value="newest">Newest</option>
            <option value="price-low">Price: Low to High</option>
            <option value="price-high">Price: High to Low</option>
            <option value="popular">Most Popular</option>
          </select>
        </div>

        <!-- View Toggle -->
        <div class="flex gap-2">
          <button
            id="grid-view-btn"
            class="view-btn p-3 border-2 border-black dark:border-white hover:bg-black dark:hover:bg-white hover:text-white dark:hover:text-black transition-colors active"
            aria-label="Grid view"
          >
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2H6a2 2 0 01-2-2V6zM14 6a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2h-2a2 2 0 01-2-2V6zM4 16a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2H6a2 2 0 01-2-2v-2zM14 16a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2h-2a2 2 0 01-2-2v-2z" />
            </svg>
          </button>
          <button
            id="list-view-btn"
            class="view-btn p-3 border-2 border-black dark:border-white hover:bg-black dark:hover:bg-white hover:text-white dark:hover:text-black transition-colors"
            aria-label="List view"
          >
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
            </svg>
          </button>
        </div>
      </div>

      <!-- Active Filters -->
      <div id="active-filters" class="mt-4 flex flex-wrap gap-2 hidden">
        <span class="text-xs font-bold tracking-[0.2em] uppercase opacity-60">Filters:</span>
      </div>
    </section>

    <!-- Products Grid -->
    <section class="max-w-7xl mx-auto px-6 py-12">

      <!-- Results Count -->
      <div class="mb-8 text-center">
        <p class="text-sm opacity-60">
          <span id="results-count">{totalProducts}</span> products
        </p>
      </div>

      <!-- Product Grid -->
      <div id="products-grid" class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
        {products.map(product => (
          <ProductCard client:load product={product} />
        ))}
      </div>

      <!-- Empty State -->
      <div id="empty-state" class="hidden text-center py-20">
        <svg class="mx-auto w-20 h-20 opacity-20 mb-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20 13V6a2 2 0 00-2-2H6a2 2 0 00-2 2v7m16 0v5a2 2 0 01-2 2H6a2 2 0 01-2-2v-5m16 0h-2.586a1 1 0 00-.707.293l-2.414 2.414a1 1 0 01-.707.293h-3.172a1 1 0 01-.707-.293l-2.414-2.414A1 1 0 006.586 13H4" />
        </svg>
        <h3 class="text-2xl font-light mb-2">No products found</h3>
        <p class="text-base opacity-60 mb-6">Try adjusting your search or filter criteria</p>
        <button
          onclick="resetFilters()"
          class="px-6 py-3 border-2 border-black dark:border-white hover:bg-black dark:hover:bg-white hover:text-white dark:hover:text-black transition-colors"
        >
          <span class="text-xs font-bold tracking-[0.2em] uppercase">Clear Filters</span>
        </button>
      </div>
    </section>

    <!-- Footer CTA -->
    <section class="max-w-7xl mx-auto px-6 py-20 border-t border-black dark:border-white">
      <div class="text-center space-y-6">
        <h2 class="text-3xl md:text-4xl font-light">
          Can't find what you're looking for?
        </h2>
        <p class="text-base opacity-80 max-w-xl mx-auto">
          Our collection is constantly growing. Sign up for our newsletter to be notified of new arrivals.
        </p>
        <div class="flex flex-col sm:flex-row gap-4 justify-center max-w-md mx-auto">
          <input
            type="email"
            placeholder="Your email address"
            class="flex-1 px-4 py-3 border-2 border-black dark:border-white bg-transparent focus:outline-none focus:ring-2 focus:ring-black dark:focus:ring-white"
          />
          <button
            class="px-8 py-3 bg-black dark:bg-white text-white dark:text-black border-2 border-black dark:border-white hover:opacity-80 transition-opacity whitespace-nowrap"
          >
            <span class="text-xs font-bold tracking-[0.2em] uppercase">Subscribe</span>
          </button>
        </div>
      </div>
    </section>

    <!-- Theme Toggle -->
    <ThemeToggle client:load />
  </div>

  <script define:vars={{ products: JSON.stringify(products) }}>
    // Parse products from server
    const allProducts = JSON.parse(products);
    let filteredProducts = [...allProducts];
    let currentCategory = 'all';
    let currentSort = 'featured';
    let currentView = 'grid';
    let searchQuery = '';

    // DOM elements
    const productsGrid = document.getElementById('products-grid');
    const emptyState = document.getElementById('empty-state');
    const resultsCount = document.getElementById('results-count');
    const searchInput = document.getElementById('product-search');
    const sortSelect = document.getElementById('sort-select');
    const categoryPills = document.querySelectorAll('.category-pill');
    const gridViewBtn = document.getElementById('grid-view-btn');
    const listViewBtn = document.getElementById('list-view-btn');

    // Filter and sort functions
    function filterProducts() {
      let results = [...allProducts];

      // Filter by category
      if (currentCategory !== 'all') {
        results = results.filter(p => p.category === currentCategory);
      }

      // Filter by search
      if (searchQuery) {
        results = results.filter(p =>
          p.name.toLowerCase().includes(searchQuery.toLowerCase()) ||
          p.description.toLowerCase().includes(searchQuery.toLowerCase()) ||
          p.category.toLowerCase().includes(searchQuery.toLowerCase())
        );
      }

      // Sort
      results = sortProducts(results, currentSort);

      filteredProducts = results;
      renderProducts();
    }

    function sortProducts(products, sortBy) {
      switch (sortBy) {
        case 'newest':
          return [...products].sort((a, b) => new Date(b.createdAt) - new Date(a.createdAt));
        case 'price-low':
          return [...products].sort((a, b) => a.price - b.price);
        case 'price-high':
          return [...products].sort((a, b) => b.price - a.price);
        case 'popular':
          return [...products].sort((a, b) => b.reviewCount - a.reviewCount);
        case 'featured':
        default:
          return [...products].sort((a, b) => (b.featured ? 1 : 0) - (a.featured ? 1 : 0));
      }
    }

    function renderProducts() {
      if (!productsGrid || !emptyState || !resultsCount) return;

      // Update count
      resultsCount.textContent = filteredProducts.length;

      // Show/hide empty state
      if (filteredProducts.length === 0) {
        productsGrid.classList.add('hidden');
        emptyState.classList.remove('hidden');
      } else {
        productsGrid.classList.remove('hidden');
        emptyState.classList.add('hidden');

        // Update grid layout
        if (currentView === 'grid') {
          productsGrid.className = 'grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8';
        } else {
          productsGrid.className = 'flex flex-col gap-6';
        }

        // Re-render product cards (would need React/Vue for proper hydration)
        // For now, just show message
        console.log('Filtered products:', filteredProducts);
      }
    }

    // Event listeners
    categoryPills.forEach(pill => {
      pill.addEventListener('click', (e) => {
        categoryPills.forEach(p => p.classList.remove('active', 'bg-black', 'dark:bg-white', 'text-white', 'dark:text-black'));
        pill.classList.add('active', 'bg-black', 'dark:bg-white', 'text-white', 'dark:text-black');
        currentCategory = pill.dataset.category;
        filterProducts();
      });
    });

    searchInput?.addEventListener('input', (e) => {
      searchQuery = e.target.value;
      filterProducts();
    });

    sortSelect?.addEventListener('change', (e) => {
      currentSort = e.target.value;
      filterProducts();
    });

    gridViewBtn?.addEventListener('click', () => {
      currentView = 'grid';
      gridViewBtn.classList.add('active', 'bg-black', 'dark:bg-white', 'text-white', 'dark:text-black');
      listViewBtn?.classList.remove('active', 'bg-black', 'dark:bg-white', 'text-white', 'dark:text-black');
      renderProducts();
    });

    listViewBtn?.addEventListener('click', () => {
      currentView = 'list';
      listViewBtn.classList.add('active', 'bg-black', 'dark:bg-white', 'text-white', 'dark:text-black');
      gridViewBtn?.classList.remove('active', 'bg-black', 'dark:bg-white', 'text-white', 'dark:text-black');
      renderProducts();
    });

    // Global reset function
    (window as any).resetFilters = () => {
      currentCategory = 'all';
      currentSort = 'featured';
      searchQuery = '';
      if (searchInput) searchInput.value = '';
      if (sortSelect) sortSelect.value = 'featured';
      categoryPills.forEach(p => p.classList.remove('active', 'bg-black', 'dark:bg-white', 'text-white', 'dark:text-black'));
      categoryPills[0]?.classList.add('active', 'bg-black', 'dark:bg-white', 'text-white', 'dark:text-black');
      filterProducts();
    };

    // Initial render
    filterProducts();
  </script>

  <style>
    .category-pill.active {
      background-color: black;
      color: white;
    }

    .dark .category-pill.active {
      background-color: white;
      color: black;
    }

    .view-btn.active {
      background-color: black;
      color: white;
    }

    .dark .view-btn.active {
      background-color: white;
      color: black;
    }
  </style>
</ShopLayout>
