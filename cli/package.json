{
  "name": "oneie",
  "version": "3.6.13",
  "description": "ONE Platform CLI - Build apps, websites, and AI agents in English",
  "type": "module",
  "bin": {
    "oneie": "./bin/oneie.js"
  },
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "files": [
    "dist",
    "bin",
    "templates",
    "README.md",
    "LICENSE.md"
  ],
  "scripts": {
    "dev": "tsc --watch",
    "build": "tsc",
    "prepublishOnly": "bun run build",
    "test": "vitest",
    "lint": "eslint src --ext .ts",
    "format": "prettier --write src"
  },
  "keywords": [
    "cli",
    "scaffold",
    "generator",
    "astro",
    "react",
    "tailwind",
    "convex",
    "ontology",
    "ai",
    "one"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/one-ie/cli"
  },
  "homepage": "https://one.ie",
  "bugs": {
    "url": "https://github.com/one-ie/cli/issues"
  },
  "author": "ONE Platform",
  "license": "SEE LICENSE IN LICENSE.md",
  "dependencies": {
    "commander": "^12.1.0",
    "prompts": "^2.4.2",
    "chalk": "^5.4.1",
    "ora": "^8.1.1",
    "degit": "^2.8.4",
    "fs-extra": "^11.3.2",
    "execa": "^9.6.1"
  },
  "devDependencies": {
    "@types/node": "^22.16.0",
    "@types/prompts": "^2.4.9",
    "@types/fs-extra": "^11.0.4",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4",
    "eslint": "^9.36.0",
    "prettier": "^3.6.2"
  },
  "engines": {
    "node": ">=22.0.0",
    "bun": ">=1.2.0"
  }
}
